# 密钥 / 凭据
docs/doris-connection.md
**/*.env
**/secrets/
**/.secrets/
config/auth-users.yaml
config/title-llm.yaml
config/memory-llm.yaml
# The seeded doris-query SKILL.md embeds a live read-only credential; the .example
# (redacted) is committed instead. Provision the real file on the host.
sandbox-image/files/usr/local/share/agents-kb-seed/skills/doris-query/SKILL.md
# Same for obs-parquet-duckdb: embeds the live OBS access/secret key.
sandbox-image/files/usr/local/share/agents-kb-seed/skills/obs-parquet-duckdb/SKILL.md
# KB data/ holds each deployment's own reference corpora — private domain
# knowledge, not part of the generic runtime. Nothing under it is committed (not
# even file listings or manifests: those leak source filenames). Provision the
# datasets on the host KB snapshot out-of-band, plus their skills/*/SKILL.md and
# facts/*.md entry points. See data/README.md for the conventions.
sandbox-image/files/usr/local/share/agents-kb-seed/data/*/

# 每台构建机自己的镜像源 / DNS 配置（已被 **/*.env 覆盖，此处仅作说明）
# sandbox-image/build.env — 见 sandbox-image/build.env.example

# gVisor / sandbox 产物
sandbox-image/rootfs/
sandbox-image/out/
bundle/out/
bundle/checkpoints/
/var/lib/harness/
*.oci.tar
*.rootfs.tar

# 构建产物
orchestrator/orchestrator
orchestrator/bin/
orchestrator/authhash
# dev/ 的脚本入库,但本地运行产物不入库(dev/model-proxy/.env 已被 **/*.env 覆盖)
dev/logs/
dev/orchestrator
dev/local.env
dev/mcp-gateway/.env

.scratch/

# 备份文件
*.bak
*.bak.*
# 带时间戳的运维备份（DB / 配置 / 前端构建产物）
*.backup.*
config/auth-users.yaml.bak.*
frontend/.next.backup.*/
# 手工运维备份常写成 .next.bak-<原因>-<日期>/，连字符不匹配上面的 *.bak.*
frontend/.next.bak-*/
orchestrator.db.bak.*

# 本地 agent 运维笔记,不入库
AGENTS.md
# Claude Code 的本地状态(worktrees / 会话配置),不入库
.claude/

# 通用
.DS_Store
node_modules/
dist/
build/
.next/
__pycache__/
*.pyc
.venv/
venv/

# IDE
.idea/
.vscode/

# trajectory-evolve run products (also in trajectory-evolve/.gitignore)
trajectory-evolve/state/
