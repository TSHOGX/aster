          "type": "string"
        },
        "group_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "policy_revision": {
          "type": "integer"
        },
        "schema_digest": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        }
      },
      "required": [
