{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "grant_id": {
          "type": "string"
        },
        "group_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "policy_revision": {
          "type": "integer"
        },
        "schema_digest": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "group_id",
        "schema_digest",
        "digest",
        "size",
        "media_type",
        "grant_id",
        "policy_revision"
      ],
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_artifact_bytes": {
          "type": "integer"
        },
        "max_attempts": {
          "type": "integer"
        },
        "max_cost_micros": {
          "type": "integer"
        },
        "max_tokens": {
          "type": "integer"
        },
        "timeout_seconds": {
          "type": "integer"
        }
      },
      "required": [
        "max_cost_micros",
        "max_tokens",
        "max_attempts",
        "timeout_seconds",
        "max_artifact_bytes"
      ],
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "type": "string"
        },
        "library_id": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "tree_digest": {
          "type": "string"
        }
      },
      "required": [
        "library_id",
        "commit_id",
        "profile",
        "tree_digest"
      ],
      "type": "object"
    },
    "EvaluationPolicy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/Revision"
        },
        "reference_release": {
          "$ref": "#/$defs/ReleaseRef"
        },
        "reference_strategy": {
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "mode",
        "reference_strategy"
      ],
      "type": "object"
    },
    "GenerationAssignment": {
      "additionalProperties": false,
      "properties": {
        "automatic": {
          "type": "boolean"
        },
        "batch_id": {
          "type": "string"
        },
        "binding_id": {
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "group_id": {
          "type": "string"
        },
        "occurrence_id": {
          "type": "string"
        },
        "pins": {
          "$ref": "#/$defs/RunPins"
        },
        "requester": {
          "$ref": "#/$defs/Principal"
        },
        "run_id": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "group_id",
        "binding_id",
        "occurrence_id",
        "requester",
        "automatic",
        "pins",
        "budget"
      ],
      "type": "object"
    },
    "GenerationDependency": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "binding_id": {
          "type": "string"
        },
        "fence": {
          "type": "integer"
        },
        "input_port": {
          "type": "string"
        },
        "output_port": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      },
      "required": [
        "input_port",
        "binding_id",
        "run_id",
        "output_port",
        "fence",
        "artifact"
      ],
      "type": "object"
    },
    "OutputBinding": {
      "additionalProperties": false,
      "properties": {
        "library_id": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "reservation_generation": {
          "type": "integer"
        }
      },
      "required": [
        "library_id",
        "prefix",
        "profile",
        "reservation_generation"
      ],
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "subject",
        "kind"
      ],
      "type": "object"
    },
    "ReleaseRef": {
      "additionalProperties": false,
      "properties": {
        "descriptor_digest": {
          "type": "string"
        },
        "library_id": {
          "type": "string"
        },
        "publisher_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "publisher_id",
        "library_id",
        "version_id",
        "descriptor_digest"
      ],
      "type": "object"
    },
    "Revision": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "RunPins": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/ContentRef"
        },
        "configuration_digest": {
          "type": "string"
        },
        "configuration_revision": {
          "type": "integer"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/GenerationDependency"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "evaluation": {
          "$ref": "#/$defs/EvaluationPolicy"
        },
        "input_ports": {
          "additionalProperties": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "output": {
          "$ref": "#/$defs/OutputBinding"
        },
        "service": {
          "$ref": "#/$defs/Revision"
        },
        "source_policy_revision": {
          "type": "integer"
        },
        "template": {
          "$ref": "#/$defs/Revision"
        },
        "workflow": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "configuration_revision",
        "configuration_digest",
        "source_policy_revision",
        "template",
        "workflow",
        "service",
        "inputs",
        "base",
        "output",
        "evaluation"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/GenerationAssignment",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
