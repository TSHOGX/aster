{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "grant_id": {
          "type": "string"
        },
        "group_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "policy_revision": {
          "type": "integer"
        },
        "schema_digest": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "group_id",
        "schema_digest",
        "digest",
        "size",
        "media_type",
        "grant_id",
        "policy_revision"
      ],
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_artifact_bytes": {
          "type": "integer"
        },
        "max_attempts": {
          "type": "integer"
        },
        "max_cost_micros": {
          "type": "integer"
        },
        "max_tokens": {
          "type": "integer"
        },
        "timeout_seconds": {
          "type": "integer"
        }
      },
      "required": [
        "max_cost_micros",
        "max_tokens",
        "max_attempts",
        "timeout_seconds",
        "max_artifact_bytes"
      ],
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "subject",
        "kind"
      ],
      "type": "object"
    },
    "Revision": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "RuntimeAllocation": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "fence": {
          "type": "integer"
        },
        "group_id": {
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "request_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "request_id",
        "principal",
        "group_id",
        "run_id",
        "fence",
        "budget",
        "inputs",
        "runtime"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/RuntimeAllocation",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
