{
  "version": 1,
  "id": "model-proxy",
  "backend_id": "REPLACE_WITH_ENGINE_STORE_ID",
  "listen": "192.0.2.1:18080",
  "reserved": "10.80.0.0/16",
  "control": "../.harness-local/development/model-control.sock",
  "application_uid": 1000,
  "control_group": 1001,
  "authorization": "../.harness-local/development/authorization.sock",
  "request_timeout": "50s",
  "upstreams": [
    {
      "endpoint_id": "inference",
      "models": [
        "example-model"
      ],
      "base_url": "https://model-upstream.example.invalid",
      "api_key_header": "X-Api-Key",
      "api_key_file": "../.harness-local/development/upstream.key",
      "extra_headers": {
        "Anthropic-Version": "2023-06-01"
      }
    }
  ]
}
