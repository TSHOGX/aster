{
  "version": 1,
  "listen": "127.0.0.1:8080",
  "frontend": "http://127.0.0.1:3000",
  "state_directory": "../state",
  "engine": {
    "endpoint": "http://127.0.0.1:8090",
    "store_id": "REPLACE_WITH_ENGINE_STORE_ID"
  },
  "template": {
    "id": "agent-runtime",
    "manifest": "../releases/agent-runtime.manifest.json",
    "digest": "REPLACE_WITH_RUNTIME_RELEASE_DIGEST"
  },
  "project": {
    "cpu_millis": 2000,
    "memory_bytes": 2147483648,
    "disk_bytes": 268435456,
    "workspace_bytes": 1073741824,
    "runtime_bytes": 536870912,
    "reachability": {}
  },
  "content": {
    "agent_config": "agent-config.example",
    "shared_assets": "shared-assets",
    "volume_bytes": 67108864
  },
  "limits": {
    "projects": 4,
    "agents": 32,
    "agents_per_project": 8,
    "terminals": 32,
    "terminals_per_project": 8,
    "idle_after": "5m",
    "idle_agent_after": "1m",
    "interval": "250ms"
  },
  "notifications": {
    "agent_run_outcome": false,
    "conversation_shared": true,
    "operator_directed": true,
    "operator_broadcast": true
  }
}
