# Copy to .env (gitignored via **/*.env) before running the gateway against a
# real upstream. Never commit real tokens.

# Gateway listen
PORT=8103
BIND=0.0.0.0
# URL the *sandbox* uses to reach this gateway (alias or host IP).
PUBLIC_BASE_URL=http://harness-mcp.internal:8103

# --- pick one or both upstreams ---

# Legacy SSE (data-governance style). Leave empty if unused.
# UPSTREAM_SSE_URL=http://{host}:8003/data-governance-service/api/v1/sse

# Streamable HTTP (dingpan / "type": "http" style). Single MCP endpoint URL.
UPSTREAM_HTTP_URL=http://mcpgateway.his.huawei.com/mcp/6a5774166fabb7775031d87a

# Also set harness.data_proxies.mcp.enabled: true with matching kind:
#   mcp_sse              + UPSTREAM_SSE_URL
#   mcp_streamable_http  + UPSTREAM_HTTP_URL

# Injected by the gateway. Stripped if the sandbox ever sends its own.
UPSTREAM_AUTHORIZATION=Bearer replace-me
# UPSTREAM_X_AUTH_TOKEN=replace-me

# MVP default: off. Set to 1 once orchestrator accepts domain=mcp on
# /internal/dataplane/requests/authorize and the gateway unit runs as
# harness.proxy_service_identity.
REQUIRE_AUTHZ=0
# HARNESS_PROXY_CORRELATION_SOCKET=/var/lib/harness/run/proxy-internal/proxy-correlation.sock
