# Copy to dev/local.env (gitignored) to override anything machine-specific.
# Every value below has a sensible auto-detected default, so an empty
# dev/local.env — or no file at all — is fine.
#
# Prefer: ./dev/configure-local.sh   (seeds a commented stub)

# Extra hosts the browser may load the Next dev server from. Defaults to the
# detected VM IP + sbx.orb.local + localhost. Add an IP here if you reach the
# dev server from somewhere else.
#HARNESS_DEV_ORIGINS=203.0.113.10,my-other-host

# Unprivileged user the frontend runs as. Defaults to the checkout's owner.
#FRONTEND_USER=myuser

# Where the local model-proxy stand-in lives. Defaults to dev/model-proxy.
#PROXY_DIR=/path/to/model-proxy

# Raise orchestrator log verbosity.
#HARNESS_LOG_LEVEL=debug
