#!/usr/bin/env bash
# harness-ctl — publish 环境运维 CLI
#
# 子命令：
#   status                服务状态 + 是否处于维护模式 + 在途对话数（一屏总览）
#   inflight              列出正在进行的 turn（queued/leased/running），含归属用户/会话标题、时长与僵尸 lease
#   zombies               扫描僵尸/状态漂移 session + maintenance 循环卡死
#   traffic [N]           从 nginx access.log 汇总最近 N 行流量（QPS/状态码/top IP/top 路径），默认 5000
#   stats [天数]          每日新增提问/回复/会话/活跃用户/新用户，表格 + 纵向柱状图 + sparkline
#   users [N] [--by=…]    用户维度：会话数/提问数/存储占用/首末活跃日，表格 + 横向条形图
#   storage [N]           存储总览：数据根目录按子目录 + Top N 会话占用
#   kb status|diff        共享知识库（/agents）：线上快照 vs 夜间进化暂存的待审批快照
#   kb approve|reject     专家放行/驳回待审批快照（自进化永不自动上线）
#   maintenance on|off    上/下维护页（nginx 层 503，不动后端）
#   maintenance status    只看当前是否维护模式
#   safe-restart <svc>    零打断重启：上维护页→等活跃对话跑完→重启→下维护页（维护页强制）
#
# 设计原则：只读监控零副作用；维护/重启操作前先备份、后验证；
# 维护配置从当前 live 配置动态生成（继承 TLS/端口），不依赖硬编码模板。
#
# 依赖：bash sqlite3 curl systemctl nginx（均已在机器上）。
# 权限：只读命令(status/inflight/traffic)普通用户即可；maintenance/safe-restart 需能
#       reload nginx / 控制 systemd（root 或有对应 sudoers）。脚本内部按需 sudo。
#
# 详见 docs/operations.md 第 9 节（维护模式）与本文件 --help。
set -euo pipefail

# ---- 常量（与 operations.md 第 1、5、9 节保持一致）----
# Publish remains the production default, while HARNESS_DATA_ROOT/HARNESS_DB
# make the same diagnostics usable against the local dev harness and staging
# copies without editing this script.
DEFAULT_DATA_ROOT="/var/lib/harness-publish"
if [[ ! -d "$DEFAULT_DATA_ROOT/state" && -d "/var/lib/harness/state" ]]; then
  DEFAULT_DATA_ROOT="/var/lib/harness"
fi
DATA_ROOT="${HARNESS_DATA_ROOT:-$DEFAULT_DATA_ROOT}"
DB="${HARNESS_DB:-$DATA_ROOT/state/orchestrator.db}"
NGINX_SITE="/etc/nginx/sites-available/harness-publish"
MAINT_HTML_DIR="/var/www/harness-maintenance"
ACCESS_LOG="/var/log/nginx/access.log"
SESS_DIR="$DATA_ROOT/sessions"      # 每 session 的 workspace
HOME_DIR="$DATA_ROOT/agent-homes"   # 每 session 的 agent HOME（含 pi/claude 轨迹）
REPO_ROOT="/home/agent-runtime-platform/main"          # 部署源码根（见 operations.md 第 5 节）
ORCH_BIN="$REPO_ROOT/orchestrator/bin/orchestrator"    # systemd ExecStart 指向的同一个二进制
AUTH_USERS="$REPO_ROOT/config/auth-users.yaml"         # 登录凭据（gitignore，只在机器上）
BACKEND_HEALTH="http://127.0.0.1:9090/healthz"
FRONTEND_URL="http://127.0.0.1:9001/"
PUBLIC_URL="https://127.0.0.1/"
SERVICES=(nginx harness-publish-orchestrator harness-publish-frontend claude-proxy.service)
# 判定「正在进行的对话」的 turn 状态（见 turns 表 CHECK 约束）
INFLIGHT_STATES="'queued','leased','running'"

# ---- 小工具 ----
c_red=$'\e[31m'; c_grn=$'\e[32m'; c_yel=$'\e[33m'; c_dim=$'\e[2m'; c_bold=$'\e[1m'; c_rst=$'\e[0m'
err()  { echo "${c_red}error:${c_rst} $*" >&2; }
die()  { err "$@"; exit 1; }
# 需要 root 的操作：已是 root 直接跑，否则 sudo
as_root() { if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi; }
# 只读 sqlite（DB 是 root:root 0644，普通用户能读；WAL 下用 -readonly 安全）
dbq() {
  if [[ -r "$DB" ]]; then sqlite3 -readonly "$DB" "$1"
  else as_root sqlite3 -readonly "$DB" "$1"; fi
}
have() { command -v "$1" >/dev/null 2>&1; }
# 读文件 mtime（epoch 秒）；bridge 目录 root 属主，普通用户读不到时回退 sudo。读不到回显空。
file_mtime() {
  local f="$1"
  if [[ -r "$f" ]]; then stat -c %Y "$f" 2>/dev/null
  else as_root stat -c %Y "$f" 2>/dev/null || true; fi
}

need_deps() {
  local m=()
  for d in sqlite3 curl systemctl; do have "$d" || m+=("$d"); done
  [[ ${#m[@]} -eq 0 ]] || die "缺少依赖：${m[*]}"
}

# 当前是否维护模式：live 配置里出现生效的 `return 503` 即为 on
is_maintenance() {
  as_root grep -qE '^\s*return 503' "$NGINX_SITE" 2>/dev/null
}

http_code() { curl -sk -o /dev/null -w '%{http_code}' --max-time 5 "$1" 2>/dev/null || echo "ERR"; }

# ---- 命令：status ----
cmd_status() {
  echo "${c_bold}== 服务状态 ==${c_rst}"
  for svc in "${SERVICES[@]}"; do
    local st; st=$(systemctl is-active "$svc" 2>/dev/null || true)
    local mark; [[ "$st" == "active" ]] && mark="${c_grn}●${c_rst}" || mark="${c_red}●${c_rst}"
    printf "  %s %-34s %s\n" "$mark" "$svc" "$st"
  done

  echo
  echo "${c_bold}== 对外入口 ==${c_rst}"
  if is_maintenance; then
    echo "  模式: ${c_yel}维护中 (MAINTENANCE)${c_rst}"
  else
    echo "  模式: ${c_grn}正常运行${c_rst}"
  fi
  printf "  公网 :443 -> %s   后端 :9090 -> %s   前端 :9001 -> %s\n" \
    "$(http_code "$PUBLIC_URL")" "$(http_code "$BACKEND_HEALTH")" "$(http_code "$FRONTEND_URL")"

  echo
  echo "${c_bold}== 在途对话 ==${c_rst}"
  local n; n=$(dbq "SELECT COUNT(*) FROM turns WHERE status IN ($INFLIGHT_STATES);" 2>/dev/null || echo "?")
  local live; live=$(dbq "SELECT COUNT(*) FROM turns WHERE status='running';" 2>/dev/null || echo "?")
  if [[ "$n" == "0" ]]; then
    echo "  ${c_grn}无正在进行的 turn — 可安全重启${c_rst}"
  else
    echo "  ${c_yel}${n} 个 turn 在途（其中 running=${live}）— 重启会打断，详见: harness-ctl inflight${c_rst}"
  fi
  local drift; drift=$(dbq "SELECT COUNT(*)
    FROM sessions s
    LEFT JOIN runtime_generations g
      ON g.generation_id=s.active_generation_id AND g.session_id=s.id
    WHERE s.status='running_active'
      AND (g.generation_id IS NULL OR g.status IN ('failed','destroyed'))
      AND NOT EXISTS (
        SELECT 1 FROM turns t
        WHERE t.session_id=s.id AND t.status IN ($INFLIGHT_STATES)
      );" 2>/dev/null || echo "?")
  if [[ "$drift" != "0" ]]; then
    echo "  ${c_yel}${drift} 个 session 存在状态漂移（running_active 但无活跃 generation/turn）— 后端会自动 reconciliation${c_rst}"
  fi
}

# ---- 命令：inflight ----
cmd_inflight() {
  local now_epoch; now_epoch=$(date -u +%s)
  echo "${c_bold}正在进行的 turn（queued/leased/running）：${c_rst}"
  # 归属信息来自 sessions（user_id 由外部系统托管、不落 users 表，见 operations.md 统计口径）。
  # title 里可能有 '|'（本函数用 '|' 拆列），SQL 侧先替换掉；substr 按字符数截断（UTF-8 安全）。
  local rows
  rows=$(dbq "SELECT t.session_id, COALESCE(NULLIF(s.user_id,''),'?'), t.status,
                     COALESCE(t.started_at,''), COALESCE(t.lease_expires_at,''), t.created_at,
                     REPLACE(substr(COALESCE(NULLIF(s.title,''),'(无标题)'),1,24),'|','/')
              FROM turns t LEFT JOIN sessions s ON s.id = t.session_id
              WHERE t.status IN ($INFLIGHT_STATES)
              ORDER BY t.created_at DESC;")
  if [[ -z "$rows" ]]; then
    echo "  ${c_grn}(无)${c_rst}"
    return 0
  fi
  printf "  %-22s %-10s %-8s %-6s %-9s %s\n" "SESSION" "USER" "STATUS" "AGE" "LEASE" "会话 / 备注"
  local zombies=0 realactive=0
  local -A user_live=() user_zomb=()
  while IFS='|' read -r sid uid status started lease created title; do
    [[ -z "$sid" ]] && continue
    # 年龄按 created_at 算（ISO8601 带纳秒，截到秒交给 date）
    local age="-" note=""
    local cts; cts=$(date -u -d "${created%.*}Z" +%s 2>/dev/null || echo "")
    [[ -n "$cts" ]] && age="$(( (now_epoch - cts) / 60 ))m"
    # 颜色与文本分开：先按纯文本宽度补齐再上色，否则转义序列会被算进列宽导致错位
    local leasetxt="-" leaseclr=""
    if [[ -n "$lease" ]]; then
      local lts; lts=$(date -u -d "${lease%.*}Z" +%s 2>/dev/null || echo "")
      if [[ -n "$lts" ]]; then
        if (( lts < now_epoch )); then
          leasetxt="expired"; leaseclr="$c_red"; note="  ${c_dim}僵尸lease/已过期,不算真活跃${c_rst}"
          zombies=$((zombies+1)); user_zomb["$uid"]=$(( ${user_zomb["$uid"]:-0} + 1 ))
        else
          leasetxt="ok"; leaseclr="$c_grn"
          realactive=$((realactive+1)); user_live["$uid"]=$(( ${user_live["$uid"]:-0} + 1 ))
        fi
      fi
    else
      # queued 无 lease：真在途（等待处理）
      realactive=$((realactive+1)); user_live["$uid"]=$(( ${user_live["$uid"]:-0} + 1 ))
    fi
    printf "  %-22s %-10s %-8s %-6s %s%-9s%s %s%b\n" \
      "$sid" "$uid" "$status" "$age" \
      "$leaseclr" "$leasetxt" "${leaseclr:+$c_rst}" "$title" "$note"
  done <<< "$rows"
  echo
  echo "  ${c_bold}真活跃 ~${realactive}${c_rst}，僵尸/过期 lease ${zombies}"
  # 按用户聚合：谁在跑、跑几个（重启/维护前判断"打断谁"）
  if (( ${#user_live[@]} + ${#user_zomb[@]} > 0 )); then
    local uids; uids=$(printf '%s\n' "${!user_live[@]}" "${!user_zomb[@]}" | sort -u)
    local parts=()
    while read -r u; do
      [[ -z "$u" ]] && continue
      local lv=${user_live["$u"]:-0} zb=${user_zomb["$u"]:-0}
      local seg="$u:${lv}活"
      (( zb > 0 )) && seg="$seg/${zb}僵"
      parts+=("$seg")
    done <<< "$uids"
    echo "  ${c_bold}按用户${c_rst}：${parts[*]}"
  fi
  echo "  ${c_dim}判定：lease 未过期的 running/leased + 所有 queued 视为真活跃；过期 lease 是卡死残留。${c_rst}"
  echo "  ${c_dim}USER = sessions.user_id（外部系统工号）；单用户明细见 harness-ctl users。${c_rst}"
}

# ---- 命令：zombies ----
# 僵尸 session：session 卡在 running_active，但其活跃 generation 的沙箱侧 bridge 心跳
# 文件已长时间不更新（沙箱进程死/卡），且有 inflight turn。这类 session 前端永远显示
# "thinking"、无法输入/打断。⚠️ inflight 子命令按 lease 过期判断，发现不了这类——因为
# orchestrator 的 maintenance 循环会无条件自续租 generation lease，把沙箱的沉默掩盖掉，
# 所以 lease 永不过期。本命令改用「沙箱 bridge 心跳文件新鲜度」这一独立判据。
#
# 判据阈值：沙箱心跳间隔为 heartbeat_interval(默认30s)。留足抖动/GC 余量，
# 静默 > 阈值(默认180s，约 6 个心跳周期) 视为沙箱失联。纯只读，不改任何状态。
ZOMBIE_STALL_SECS="${ZOMBIE_STALL_SECS:-180}"
cmd_zombies() {
  local now_epoch; now_epoch=$(date -u +%s)
  echo "${c_bold}僵尸 session 扫描（running_active + 沙箱心跳失联 > ${ZOMBIE_STALL_SECS}s）：${c_rst}"
  # A failed generation is no longer bridge-poll eligible, so heartbeat-based
  # zombie detection alone cannot see the second failure mode: session status
  # left at running_active after all of its work has already failed. Keep this
  # check read-only and explicit; the backend reconciliation stage repairs it
  # automatically, but operators should see the distinction immediately.
  local drift
  drift=$(dbq "SELECT s.id, REPLACE(substr(COALESCE(NULLIF(s.title,''),'(无标题)'),1,28),'|','/'),
                     COALESCE(s.active_generation_id,''),
                     COALESCE(g.status,'missing'),
                     (SELECT COUNT(*) FROM turns t
                        WHERE t.session_id=s.id AND t.status IN ($INFLIGHT_STATES))
              FROM sessions s
              LEFT JOIN runtime_generations g
                     ON g.generation_id=s.active_generation_id
                    AND g.session_id=s.id
              WHERE s.status='running_active'
                AND (g.generation_id IS NULL OR g.status IN ('failed','destroyed'))
                AND NOT EXISTS (
                  SELECT 1 FROM turns t
                  WHERE t.session_id=s.id AND t.status IN ($INFLIGHT_STATES)
                )
              ORDER BY s.updated_at;" 2>/dev/null || true)
  if [[ -n "$drift" ]]; then
    echo
    echo "${c_bold}状态漂移（session 仍 running_active，但无在途 turn / generation 已终止）：${c_rst}"
    printf "  %-24s %-28s %-38s %-10s %s\n" "SESSION" "TITLE" "GENERATION" "GEN" "INFLIGHT"
    while IFS='|' read -r dsid dtitle dgen dgenstatus dinflight; do
      [[ -z "$dsid" ]] && continue
      printf "  %-24s %-28s %-38s %-10s %s\n" "$dsid" "$dtitle" "${dgen:--}" "$dgenstatus" "$dinflight"
    done <<< "$drift"
    echo "  ${c_yel}这不是活跃任务，而是状态未收敛；后端 reconciliation 应将其回落为 running_idle。${c_rst}"
  fi
  # 每个 running_active session：活跃 generation 的 bridge_dir + 该 session 的 inflight turn 数
  local rows
  rows=$(dbq "SELECT s.id, COALESCE(s.active_generation_id,''),
                     COALESCE(r.bridge_dir_path,''),
                     COALESCE(g.sandbox_last_seen_at,''),
                     (SELECT COUNT(*) FROM turns t
                        WHERE t.session_id=s.id AND t.status IN ($INFLIGHT_STATES))
              FROM sessions s
              LEFT JOIN runtime_generations g
                     ON g.generation_id = s.active_generation_id
                    AND g.session_id = s.id
              LEFT JOIN runtime_resource_instances r
                     ON r.generation_id = s.active_generation_id
              WHERE s.status='running_active'
              ORDER BY s.id;")
  if [[ -z "$rows" ]]; then
    echo "  ${c_grn}(无 running_active session)${c_rst}"
    # 仍要查循环健康度：循环停摆时新对话根本进不了 running_active,
    # 所以"没有 running_active"绝不等于"平台健康"。
    zombie_check_maintenance_stall
    return 0
  fi
  printf "  %-24s %-9s %-14s %-14s %s\n" "SESSION" "INFLIGHT" "SANDBOX-HB" "DB-HB" "判定"
  local zombies=0 active=0 ingest_stalled=0 unknown=0
  local zlist=()
  while IFS='|' read -r sid gen bridge db_seen inflight; do
    [[ -z "$sid" ]] && continue
    local age_disp db_age_disp="无记录" db_age=-1 verdict
    if [[ -n "$db_seen" ]]; then
      local dts; dts=$(date -u -d "${db_seen%.*}Z" +%s 2>/dev/null || echo "")
      if [[ -n "$dts" ]]; then
        db_age=$(( now_epoch - dts ))
        db_age_disp="${db_age}s前"
      fi
    fi
    if [[ -z "$bridge" ]]; then
      age_disp="无资源"; verdict="${c_yel}无 live 沙箱资源(排查)${c_rst}"; unknown=$((unknown+1))
    else
      local hbf="$bridge/heartbeat/bridge"
      local m; m=$(file_mtime "$hbf")
      if [[ -z "$m" ]]; then
        age_disp="无心跳文件"; verdict="${c_yel}无心跳文件(排查)${c_rst}"; unknown=$((unknown+1))
      else
        local age=$(( now_epoch - m ))
        age_disp="${age}s前"
        if (( age > ZOMBIE_STALL_SECS )); then
          verdict="${c_red}僵尸(沙箱失联)${c_rst}"; zombies=$((zombies+1)); zlist+=("$sid")
        elif (( db_age < 0 || db_age > ZOMBIE_STALL_SECS )); then
          verdict="${c_yel}bridge ingest 卡住(文件新鲜/DB陈旧)${c_rst}"; ingest_stalled=$((ingest_stalled+1))
        else
          verdict="${c_grn}活跃${c_rst}"; active=$((active+1))
        fi
      fi
    fi
    printf "  %-24s %-9s %-14s %-14s %b\n" "$sid" "$inflight" "$age_disp" "$db_age_disp" "$verdict"
  done <<< "$rows"
  echo
  echo "  ${c_bold}僵尸 ${zombies}${c_rst}，bridge ingest 卡住 ${ingest_stalled}，活跃 ${active}，待排查 ${unknown}"
  if (( zombies > 0 )); then
    echo "  ${c_yel}僵尸 session：${zlist[*]}${c_rst}"
    echo "  ${c_dim}恢复需人工介入（备份DB→标 generation failed / turn canceled → session 回落 running_idle）。${c_rst}"
  fi
  echo "  ${c_dim}判据=沙箱 bridge 心跳文件(runtime_resource_instances.bridge_dir_path/heartbeat/bridge)新鲜度；纯只读。${c_rst}"
  zombie_check_maintenance_stall
}

# 检测「orchestrator maintenance 循环卡死」这个单点故障。
#
# 为什么单独查：上面按 session 的判据只能看到下游表象。2026-08-17 那次故障里
# 它把 7 个 session 全报成僵尸，但真正的单点是 orchestrator 卡在一个永不返回的
# `runsc kill` 子进程上，导致整个 maintenance 循环停摆、所有新对话都起不了沙箱。
# 报 N 个下游 session 会把人引向逐个改库，而正确动作是清掉那个卡住的子进程。
#
# 两条独立判据（纯只读）：
#   ① orchestrator 有长寿命 runsc 子进程（正常的 teardown 是秒级）
#   ② generation 行已建、资源标 live，但 run/logs/gen-*/ 是空的 → runsc 从未执行
# 详见 docs/proposals/runsc-cleanup-hang-blocks-maintenance.md
MAINT_STALL_CHILD_SECS="${MAINT_STALL_CHILD_SECS:-300}"
# host-heartbeat 每个 maintenance tick(heartbeat_interval,默认30s)刷新一次。
# 留足抖动余量,静默 > 180s(约 6 个 tick)视为循环停摆。
MAINT_STALL_HB_SECS="${MAINT_STALL_HB_SECS:-180}"
BRIDGE_HOST_HB_FILE="host"   # 与 bridge.HostHeartbeatFile 保持一致
MAINTENANCE_HB_FILE="$DATA_ROOT/run/maintenance-heartbeat"
zombie_check_maintenance_stall() {
  local now_epoch; now_epoch=$(date -u +%s)
  local pid; pid=$(systemctl show -p MainPID --value harness-publish-orchestrator 2>/dev/null || true)
  # Local dev runs the same binary outside systemd. Fall back to the launcher
  # pid files so the loop-health check is not silently skipped there.
  if [[ -z "$pid" || "$pid" == "0" ]]; then
    for pid_file in "$DATA_ROOT/run/orchestrator.pid" \
                    "/var/lib/harness-publish/run/orchestrator.pid" \
                    "${REPO_ROOT%/}/dev/logs/orchestrator.pid"; do
      if [[ -r "$pid_file" ]]; then
        pid=$(tr -d '[:space:]' < "$pid_file")
        [[ -n "$pid" && "$pid" != "0" ]] && break
      fi
    done
  fi
  [[ -n "$pid" && "$pid" != "0" ]] || return 0
  if ! as_root kill -0 "$pid" 2>/dev/null; then
    echo "  ${c_yel}orchestrator pid=${pid} 不存在，maintenance 循环未运行${c_rst}"
    return 0
  fi

  local findings=0 hb_frozen=0
  echo
  echo "${c_bold}maintenance 循环卡死检测（单点故障，优先于上面的 session 列表）：${c_rst}"

  # Process-level heartbeat is independent of whether any sandbox is live.
  # Unlike host-heartbeat, it still gives a definitive answer during an empty
  # platform or a cold-start outage.
  local maintenance_m; maintenance_m=$(file_mtime "$MAINTENANCE_HB_FILE")
  if [[ -z "$maintenance_m" && "$MAINTENANCE_HB_FILE" != "/var/lib/harness-publish/run/maintenance-heartbeat" ]]; then
    maintenance_m=$(file_mtime "/var/lib/harness-publish/run/maintenance-heartbeat")
  fi
  if [[ -z "$maintenance_m" ]]; then
    echo "  ${c_yel}① maintenance-heartbeat 不存在（循环尚未建立或已停止）${c_rst}"
  else
    local maintenance_age=$(( now_epoch - maintenance_m ))
    if (( maintenance_age > MAINT_STALL_HB_SECS )); then
      findings=$((findings+1)); hb_frozen=1
      echo "  ${c_red}① maintenance-heartbeat 已冻结 ${maintenance_age}s（阈值 ${MAINT_STALL_HB_SECS}s）${c_rst}"
    else
      echo "  ${c_grn}① maintenance-heartbeat 新鲜（${maintenance_age}s 前）— 循环在转${c_rst}"
    fi
  fi

  # ① 长寿命 runsc **teardown/introspection** 子进程：kill/delete/state/list 正常
  #    秒级返回,跑成分钟级即为挂死。注意必须排除 `runsc ... run` ——那是健康沙箱的
  #    常驻监督进程,本来就会跑几小时,把它算进来会对每个正常沙箱误报。
  local kids
  # `|| true`: ps 无匹配进程时退出码 1,在 set -e + pipefail 下会中断整个脚本。
  kids=$(as_root ps -o pid=,etimes=,args= --ppid "$pid" 2>/dev/null \
         | awk -v t="$MAINT_STALL_CHILD_SECS" '$2>t && /runsc/ && / (kill|delete|state|list)( |$)/' || true)
  if [[ -n "$kids" ]]; then
    findings=$((findings+1))
    echo "  ${c_red}② orchestrator 有长寿命 runsc 清理子进程（> ${MAINT_STALL_CHILD_SECS}s）：${c_rst}"
    while read -r kpid ksecs kargs; do
      [[ -z "$kpid" ]] && continue
      local kw; kw=$(as_root cat "/proc/$kpid/wchan" 2>/dev/null || true)
      printf "     PID %-8s 已运行 %-8s wchan=%-22s %s\n" \
        "$kpid" "$(printf '%dm%02ds' $((ksecs/60)) $((ksecs%60)))" "${kw:-?}" "$(echo "$kargs" | cut -c1-70)"
    done <<< "$kids"
    echo "     ${c_dim}多为半死沙箱(OOM 后控制面不应答)拖住 runsc CLI。${c_rst}"
  fi

  # ② host-heartbeat 冻结：这个文件由 maintenance 每 tick 写(bridge_dir 的 .host
  #    兄弟目录/host-heartbeat/host),所以它的新鲜度**直接**度量循环自身是否还在转
  #    ——比任何按 session 的判据都更接近根因。取所有 live 沙箱里最新的一个:只要
  #    有一个在刷新,循环就是活的。
  local newest=0 hb_seen=0
  # 只取 generation 仍 active/idle 的沙箱:maintenance 本来就不给 failed/ended
  # generation 写 host-heartbeat,把它们算进来会拿几个月前的泄漏行误报冻结。
  local bdirs
  bdirs=$(dbq "SELECT r.bridge_dir_path
               FROM runtime_resource_instances r
               JOIN runtime_generations g ON g.generation_id = r.generation_id
               WHERE r.state='live' AND COALESCE(r.bridge_dir_path,'') <> ''
                 AND g.status IN ('active','idle');" 2>/dev/null || true)
  while read -r bdir; do
    [[ -z "$bdir" ]] && continue
    local hf="${bdir}.host/host-heartbeat/${BRIDGE_HOST_HB_FILE}"
    local m; m=$(file_mtime "$hf")
    [[ -z "$m" ]] && continue
    hb_seen=1
    (( m > newest )) && newest=$m
  done <<< "$bdirs"
  if (( hb_seen == 0 )); then
    # 没有 live 沙箱 → 没有 host-heartbeat 可采样。退化为"循环是否响应"的直接探测:
    # /healthz 只证明 HTTP 层活着(那次故障里它一直是 200),所以这里只做事实陈述,
    # 不下结论,并给出人工复核入口。
    echo "  ${c_dim}③ 无 live 沙箱,host-heartbeat 无从采样（以 ① maintenance-heartbeat 为准）${c_rst}"
    echo "     ${c_dim}复核:发一条消息看能否起沙箱,或 journalctl -u harness-publish-orchestrator -n 20${c_rst}"
  else
    local hb_age=$(( now_epoch - newest ))
    if (( hb_age > MAINT_STALL_HB_SECS )); then
      findings=$((findings+1)); hb_frozen=1
      echo "  ${c_red}③ host-heartbeat 已冻结 ${hb_age}s（阈值 ${MAINT_STALL_HB_SECS}s）${c_rst}"
      echo "     ${c_dim}该文件由 maintenance 每 tick 写入,冻结即循环本身已停摆。${c_rst}"
    else
      echo "  ${c_grn}③ host-heartbeat 新鲜（${hb_age}s 前）— maintenance 循环在转${c_rst}"
    fi
  fi

  if (( findings == 0 )); then
    echo "  ${c_grn}未发现 maintenance 卡死迹象${c_rst}"
    return 0
  fi
  # 判据②(host-heartbeat 冻结)才是循环停摆的直接证据;①单独出现只说明有个清理
  # 命令挂住了,循环仍在转(修复后每条命令都有超时,这是可以自行恢复的)。区分开,
  # 避免把"有个卡住的子进程"误报成"全平台故障"。
  if (( hb_frozen == 0 )); then
    echo
    echo "  ${c_yel}判定：循环仍在转(host-heartbeat 新鲜),但有清理命令挂住。${c_rst}"
    echo "  ${c_dim}若持续不消退,按下面的止血清掉对应沙箱残骸;当前不影响新对话启动。${c_rst}"
  else
    echo
    echo "  ${c_red}判定：maintenance 循环已停摆 —— 单点故障,不要逐个改库。${c_rst}"
  fi
  echo "  ${c_dim}止血：先 SIGKILL 半死沙箱的 runsc 残骸(boot/gofer/run 三个进程),卡住的${c_rst}"
  echo "  ${c_dim}      runsc 子进程会自行返回,maintenance 复活后 cold-fallback 自动重启会话。${c_rst}"
  echo "  ${c_dim}      顺序很重要:先杀残骸,否则紧随的 delete -force 会再次挂死。${c_rst}"
  echo "  ${c_dim}辅助判据:host-heartbeat 是否冻结 —— ls -lt ${DATA_ROOT}/run/bridge/gen-*.host/ | head${c_rst}"
}

# ---- 命令：traffic ----
cmd_traffic() {
  local n="${1:-5000}"
  [[ -r "$ACCESS_LOG" ]] || { as_root test -r "$ACCESS_LOG" || die "读不到 $ACCESS_LOG"; }
  local tmp; tmp=$(mktemp)
  if [[ -r "$ACCESS_LOG" ]]; then tail -n "$n" "$ACCESS_LOG" > "$tmp"
  else as_root tail -n "$n" "$ACCESS_LOG" > "$tmp"; fi

  local lines; lines=$(wc -l < "$tmp")
  echo "${c_bold}== 流量汇总（最近 ${lines} 行 access.log）==${c_rst}"

  # 时间跨度 & 粗略 QPS：首末行的 [time]
  local t_first t_last
  t_first=$(head -1 "$tmp" | grep -oE '\[[^]]+\]' | head -1 | tr -d '[]')
  t_last=$(tail -1 "$tmp"  | grep -oE '\[[^]]+\]' | head -1 | tr -d '[]')
  echo "  窗口: ${c_dim}${t_first} → ${t_last}${c_rst}"
  # combined 格式：解析首末秒级时间算 QPS
  local ef el
  ef=$(date -d "$(echo "$t_first" | sed 's#/# #g; s#:# #; s#\([0-9]\) \([0-9][0-9]\)#\1 \2#')" +%s 2>/dev/null || echo "")
  el=$(date -d "$(echo "$t_last"  | sed 's#/# #g; s#:# #; s#\([0-9]\) \([0-9][0-9]\)#\1 \2#')" +%s 2>/dev/null || echo "")
  if [[ -n "$ef" && -n "$el" && "$el" -gt "$ef" ]]; then
    printf "  跨度 %ds，平均 %.1f req/s\n" "$((el-ef))" "$(echo "scale=2;$lines/($el-$ef)" | bc 2>/dev/null || echo 0)"
  fi

  echo
  echo "  ${c_bold}状态码分布：${c_rst}"
  awk '{print $9}' "$tmp" | sort | uniq -c | sort -rn | head -10 | awk '{printf "    %-6s %s\n",$2,$1}'

  echo
  echo "  ${c_bold}Top 10 客户端 IP：${c_rst}"
  awk '{print $1}' "$tmp" | sort | uniq -c | sort -rn | head -10 | awk '{printf "    %-18s %s\n",$2,$1}'

  echo
  echo "  ${c_bold}Top 10 路径：${c_rst}"
  awk '{print $7}' "$tmp" | sort | uniq -c | sort -rn | head -10 | awk '{printf "    %6s  %s\n",$1,$2}'

  rm -f "$tmp"
}

# ---- 存储采集 ----
# 输出 "session_id<TAB>KB"，覆盖 workspace + agent-home 两处（同 session 相加）
_session_sizes() {
  # 注意：session workspace 是 0750 nobody:nogroup，父目录可读但子目录不可读，
  # 非 root 直接 du 会静默少算 -> 统一走 as_root（内部按需 sudo）。
  local out; out=$(mktemp)
  for base in "$SESS_DIR" "$HOME_DIR"; do
    as_root du -sk "$base"/* 2>/dev/null
  done | awk -F'\t' '{n=split($2,p,"/"); kb[p[n]]+=$1}
                     END{for(s in kb) printf "%s\t%d\n", s, kb[s]}' > "$out"
  echo "$out"
}

human_kb() { awk -v k="$1" 'BEGIN{
  if(k>=1048576) printf "%.1fG",k/1048576; else if(k>=1024) printf "%.0fM",k/1024;
  else printf "%dK",k }'; }

# ---- 命令：user（登录凭据管理，免重启生效）----
# 注意与只读统计命令 `users`（复数）区分：`user`（单数）改凭据，`users` 看用量。
#
# 实际改动由 orchestrator 二进制的 `user` 子命令完成（它复用后端的 YAML 校验、
# PBKDF2 参数和会话吊销逻辑）；这里只负责：定位二进制、对齐 systemd 的环境变量、
# 用 `read -s` 隐式读密码后管道喂进去（密码不进 argv、不进 shell history）。
#
# orchestrator 写完文件即生效：后端发现文件 mtime 变了就重载凭据，不需要重启，
# 也不需要维护页。

# 从 systemd unit 里取环境变量，保证 CLI 和跑着的服务读同一份文件/同一个库。
unit_env() {
  local key="$1"
  systemctl show harness-publish-orchestrator -p Environment --value 2>/dev/null \
    | tr ' ' '\n' | sed -n "s/^${key}=//p" | tail -1
}

# ---- 命令：kb（共享知识库的专家审批门禁）----
# 定时进化只暂存快照(pending)不上线，专家在这里看 diff 后决定 approve/reject。
# approve 之后也只影响新会话：运行中的沙箱钉死在自己启动时那份快照上。
cmd_kb() {
  local action="${1:-}"; shift || true
  [[ -x "$ORCH_BIN" ]] || die "找不到可执行的 orchestrator 二进制：$ORCH_BIN"

  # 与服务对齐：unit 里显式设过就用 unit 的，否则用本文件常量兜底。
  local kb_path db_path traj_root
  kb_path="$(unit_env HARNESS_AGENTS_KB_PATH)";  kb_path="${kb_path:-$DATA_ROOT/agents-kb}"
  traj_root="$(unit_env HARNESS_TRAJECTORY_ROOT)"; traj_root="${traj_root:-$DATA_ROOT/trajectories}"
  db_path="$(unit_env HARNESS_DB_PATH)";         db_path="${db_path:-$DB}"

  case "$action" in
    status|diff|approve|reject|reseed) ;;
    -h|--help|"")
      cat <<'EOF'
harness-ctl kb — 共享知识库（/agents）审批门禁

  kb status                    当前上线快照 / 待审批快照 + 文件增删改计数
  kb diff                      current vs pending 逐文件 diff（diff -ruN）
  kb approve <digest>          批准上线：原子 repoint current，写 approvals.log
  kb reject <digest> --reason  驳回：不动 current，快照留档，写 approvals.log
  kb reseed [--path REL,…]     把仓库里的种子树覆盖到 current 之上，暂存待审批

digest 必填（防手滑批准没看过的快照）。审批记录在 agents-kb/approvals.log。

reseed 用于修正「人工种入」的文件（例如 skills/doris-query/SKILL.md）：这类文件
蒸馏管线不会重写，只会被 carryForward 原样复制到每个新快照，所以里面的错误靠
定时进化永远消不掉。reseed 也只暂存不上线，仍需 kb diff 复核 + kb approve。
EOF
      return 0 ;;
    *) die "未知 kb 子命令：$action（支持 status|diff|approve|reject|reseed）" ;;
  esac

  # reseed 的默认种子路径由 RepoRoot 推导，必须与服务看到的仓库一致。
  as_root env HARNESS_AGENTS_KB_PATH="$kb_path" HARNESS_TRAJECTORY_ROOT="$traj_root" \
    HARNESS_DB_PATH="$db_path" HARNESS_REPO_ROOT="$REPO_ROOT" "$ORCH_BIN" kb "$action" "$@"
}

cmd_user() {
  local action="${1:-}"; shift || true
  [[ -x "$ORCH_BIN" ]] || die "找不到可执行的 orchestrator 二进制：$ORCH_BIN"

  # 与服务对齐：unit 里显式设过就用 unit 的，否则用 config.Load 的默认推导。
  local users_path db_path
  users_path="$(unit_env HARNESS_AUTH_USERS_PATH)"; users_path="${users_path:-$AUTH_USERS}"
  db_path="$(unit_env HARNESS_DB_PATH)"; db_path="${db_path:-$DB}"

  run_orch() { as_root env HARNESS_AUTH_USERS_PATH="$users_path" HARNESS_DB_PATH="$db_path" \
                 "$ORCH_BIN" user "$@"; }
  # add/passwd 需要密码：TTY 下静默读两次比对，非 TTY 下直接透传 stdin（便于脚本化）。
  run_orch_with_password() {
    if [[ -t 0 ]]; then
      local pw1 pw2
      read -rsp "新密码：" pw1; echo
      read -rsp "再输一次：" pw2; echo
      [[ -n "$pw1" ]] || die "密码不能为空"
      [[ "$pw1" == "$pw2" ]] || die "两次输入不一致"
      printf '%s' "$pw1" | run_orch "$@" --password-stdin
    else
      run_orch "$@" --password-stdin
    fi
  }

  case "$action" in
    list|ls|"")   run_orch list ;;
    add)          [[ -n "${1:-}" ]] || die "用法：harness-ctl user add <用户名>"
                  run_orch_with_password add "$1" ;;
    passwd|pw)    [[ -n "${1:-}" ]] || die "用法：harness-ctl user passwd <用户名> [--keep-sessions]"
                  local name="$1"; shift
                  run_orch_with_password passwd "$name" "$@" ;;
    rm|remove|del) [[ -n "${1:-}" ]] || die "用法：harness-ctl user rm <用户名> [--force] [--keep-sessions]"
                  run_orch rm "$@" ;;
    -h|--help|help) run_orch --help ;;
    *)            err "未知子命令：user $action"; run_orch --help; exit 1 ;;
  esac
}

# ---- 命令：users ----
cmd_users() {
  local top="${1:-20}" sort_key="msgs"
  for a in "$@"; do case "$a" in --by=*) sort_key="${a#--by=}";; esac; done
  [[ "$top" =~ ^[0-9]+$ ]] || top=20
  case "$sort_key" in msgs|storage|sessions) ;; *) die "--by 只支持 msgs|storage|sessions";; esac

  local sizes; sizes=$(_session_sizes)
  # session -> user 映射
  local map; map=$(mktemp)
  dbq "SELECT id||CHAR(9)||user_id FROM sessions;" > "$map"

  local peruser; peruser=$(mktemp)
  dbq "
    SELECT s.user_id ||'|'|| COUNT(DISTINCT s.id) ||'|'||
           SUM(CASE WHEN m.role='user' THEN 1 ELSE 0 END) ||'|'||
           COALESCE(MIN(date(m.created_at,'+8 hours')),'-') ||'|'||
           COALESCE(MAX(date(m.created_at,'+8 hours')),'-')
    FROM sessions s LEFT JOIN messages m ON m.session_id=s.id
    GROUP BY s.user_id;" > "$peruser"

  # 汇总每用户存储（含 DB 中已无记录的孤儿目录）
  local joined; joined=$(mktemp)
  awk -F'\t' 'NR==FNR{u[$1]=$2; next}
              { uid=($1 in u)? u[$1] : "(孤儿目录)"; kb[uid]+=$2 }
              END{for(x in kb) printf "%s|%d\n", x, kb[x]}' "$map" "$sizes" > "$joined"

  echo "${c_bold}== 用户用量（按 ${sort_key} 排序，Top ${top}）==${c_rst}"
  # 表头手工对齐（CJK 双宽，见 cmd_stats 同处注释）
  printf "  ${c_bold}%s${c_rst}\n" "用户               会话     提问       存储         首次         最近"
  printf "  %s\n" "──────────────────────────────────────────────────────────────────────"
  local table; table=$(awk -F'|' -v key="$sort_key" '
    NR==FNR{ kb[$1]=$2; next }
    { u=$1; s=$2; q=$3; f=$4; l=$5; k=(u in kb)?kb[u]:0
      sk=(key=="storage")?k:((key=="sessions")?s:q)
      printf "%d|%s|%s|%s|%d|%s|%s\n", sk, u, s, q, k, f, l }
    ' "$joined" "$peruser" | sort -t'|' -k1,1rn)
  local shown=0
  while IFS='|' read -r _ u s q k f l; do
    [[ -z "$u" ]] && continue
    shown=$((shown+1)); [[ "$shown" -gt "$top" ]] && continue
    printf "  %-14s %8s %8s %10s %12s %12s\n" "$u" "$s" "$q" "$(human_kb "$k")" "$f" "$l"
  done <<<"$table"
  printf "  %s\n" "──────────────────────────────────────────────────────────────────────"
  # 合计覆盖全部用户（不止 Top N）；标签按显示宽度补空格
  # 合计覆盖全部用户（不止 Top N）。"合计" 显示宽 4，用户数占 ${#shown} 列，
  # 补到 14 列宽 -> 14-4-1-len-1 个空格（bash 侧算好，避免依赖 awk 的 locale 宽度）
  local pad=$(( 14 - 6 - ${#shown} )); (( pad < 1 )) && pad=1
  awk -F'|' -v sp="$(printf '%*s' "$pad" '')" -v n="$shown" '{s+=$3;q+=$4;k+=$5}
    END{ printf "  合计 %s 人%s %8d %8d %10s\n", n, sp, s, q,
           (k>=1048576?sprintf("%.1fG",k/1048576):sprintf("%.0fM",k/1024))}' <<<"$table"

  echo
  echo "  ${c_bold}存储占用${c_rst}"
  awk -F'|' -v t="$top" '{if(++i<=t) printf "%s|%d|%s\n",$2,$5,($5>=1048576?sprintf("%.1fG",$5/1048576):($5>=1024?sprintf("%.0fM",$5/1024):sprintf("%dK",$5)))}' \
    <<<"$(sort -t'|' -k5,5rn <<<"$table")" | hbar 40 14
  echo
  echo "  ${c_bold}提问量${c_rst}"
  awk -F'|' -v t="$top" '{if(++i<=t) print $2"|"$4}' <<<"$(sort -t'|' -k4,4rn <<<"$table")" | hbar 40 14

  rm -f "$sizes" "$map" "$peruser" "$joined"
}

# ---- 命令：storage ----
cmd_storage() {
  local top="${1:-15}"
  [[ "$top" =~ ^[0-9]+$ ]] || top=15
  echo "${c_bold}== 存储总览（${DATA_ROOT}）==${c_rst}"
  local totals; totals=$(as_root du -sk "$DATA_ROOT"/* 2>/dev/null | sort -rn)
  local grand; grand=$(as_root du -sk "$DATA_ROOT" 2>/dev/null | awk '{print $1}')
  printf "  总计 ${c_bold}%s${c_rst}   磁盘: %s\n\n" "$(human_kb "${grand:-0}")" \
    "$(df -h "$DATA_ROOT" | awk 'NR==2{printf "%s 已用 / %s (%s)",$3,$2,$5}')"
  echo "  ${c_bold}按目录${c_rst}"
  awk -F'\t' '{n=split($2,p,"/"); k=$1
    h=(k>=1048576)?sprintf("%.1fG",k/1048576):((k>=1024)?sprintf("%.0fM",k/1024):sprintf("%dK",k))
    print p[n]"|"k"|"h}' <<<"$totals" | hbar 40 16

  local dbsz; dbsz=$(as_root du -ck "$DB" "$DB-wal" 2>/dev/null | awk 'END{print $1}')
  printf "\n  ${c_dim}orchestrator.db(+wal): %s；messages 表 %s 行${c_rst}\n" \
    "$(human_kb "${dbsz:-0}")" "$(dbq 'SELECT COUNT(*) FROM messages;')"

  echo
  echo "  ${c_bold}Top ${top} 会话（workspace + agent-home）${c_rst}"
  local sizes; sizes=$(_session_sizes)
  local map; map=$(mktemp)
  dbq "SELECT id||CHAR(9)||user_id||' '||substr(COALESCE(NULLIF(title,''),'(无标题)'),1,20) FROM sessions;" > "$map"
  awk -F'\t' 'NR==FNR{u[$1]=$2; next}
    { lab=($1 in u)? u[$1] : "(孤儿) " substr($1,6,10); k=$2
      h=(k>=1048576)?sprintf("%.1fG",k/1048576):((k>=1024)?sprintf("%.0fM",k/1024):sprintf("%dK",k))
      print lab"|"k"|"h }' "$map" "$sizes" | sort -t'|' -k2,2rn | head -n "$top" | hbar 36 30
  rm -f "$sizes" "$map"
}

# ---- 命令：stats ----
# 每日新增：user message / assistant reply / session / 活跃用户 / 新用户
# 口径见 docs/operations.md：用户身份来自 sessions.user_id（users 表只有内置账号），
# created_at 为 UTC，统一 +8h 归到本地自然日。
_stats_sql() {
  local days="$1"
  cat <<SQL
WITH RECURSIVE spine(d) AS (
  SELECT date('now','+8 hours', '-$((days-1)) day')
  UNION ALL SELECT date(d,'+1 day') FROM spine WHERE d < date('now','+8 hours')
),
msg AS (
  SELECT date(created_at,'+8 hours') d,
         SUM(role='user') uq, SUM(role='assistant') ar
  FROM messages GROUP BY d
),
sess AS (
  SELECT date(created_at,'+8 hours') d, COUNT(*) ns FROM sessions GROUP BY d
),
act AS (
  SELECT date(m.created_at,'+8 hours') d, COUNT(DISTINCT s.user_id) au
  FROM messages m JOIN sessions s ON s.id=m.session_id
  WHERE m.role='user' GROUP BY d
),
firstseen AS (
  SELECT s.user_id u, MIN(date(m.created_at,'+8 hours')) fd
  FROM messages m JOIN sessions s ON s.id=m.session_id
  WHERE m.role='user' GROUP BY u
),
newu AS (SELECT fd d, COUNT(*) nu FROM firstseen GROUP BY fd)
SELECT spine.d,
       COALESCE(msg.uq,0), COALESCE(msg.ar,0), COALESCE(sess.ns,0),
       COALESCE(act.au,0), COALESCE(newu.nu,0)
FROM spine
LEFT JOIN msg  ON msg.d=spine.d
LEFT JOIN sess ON sess.d=spine.d
LEFT JOIN act  ON act.d=spine.d
LEFT JOIN newu ON newu.d=spine.d
ORDER BY spine.d;
SQL
}

cmd_stats() {
  local days="${1:-14}"
  [[ "$days" =~ ^[0-9]+$ && "$days" -ge 1 ]] || die "天数须为正整数，收到：$days"
  local rows; rows=$(dbq "$(_stats_sql "$days")")
  [[ -n "$rows" ]] || die "查不到数据（DB: $DB）"

  # 全量累计 + 窗口内去重用户
  local tot; tot=$(dbq "
    SELECT (SELECT COUNT(*) FROM messages WHERE role='user'),
           (SELECT COUNT(*) FROM sessions),
           (SELECT COUNT(DISTINCT user_id) FROM sessions),
           (SELECT MIN(date(created_at,'+8 hours')) FROM messages);")
  local win_users; win_users=$(dbq "
    SELECT COUNT(DISTINCT s.user_id) FROM messages m JOIN sessions s ON s.id=m.session_id
    WHERE m.role='user' AND date(m.created_at,'+8 hours') >= date('now','+8 hours','-$((days-1)) day');")
  IFS='|' read -r t_uq t_ns t_nu t_since <<<"$tot"

  echo "${c_bold}== 使用量统计（最近 ${days} 天，本地时区 UTC+8）==${c_rst}"
  printf "  ${c_dim}累计: %s 提问 / %s 会话 / %s 用户，自 %s 起；窗口内活跃用户 %s${c_rst}\n" \
    "$t_uq" "$t_ns" "$t_nu" "$t_since" "$win_users"
  echo
  # 表头手工对齐：CJK 为双宽字符，printf 按字符数计宽会错位，故按显示宽度补空格
  printf "  ${c_bold}%s${c_rst}\n" "日期             提问     回复   新会话 活跃用户   新用户"
  printf "  %s\n" "────────────────────────────────────────────────────────────"
  local today; today=$(date -d "@$(( $(date -u +%s) + 28800 ))" -u +%F)
  while IFS='|' read -r d uq ar ns au nu; do
    [[ -z "$d" ]] && continue
    local mark="" rst=""
    [[ "$d" == "$today" ]] && { mark="$c_grn"; rst="$c_rst"; }
    printf "  ${mark}%-12s %8s %8s %8s %8s %8s${rst}\n" "$d" "$uq" "$ar" "$ns" "$au" "$nu"
  done <<<"$rows"
  printf "  %s\n" "────────────────────────────────────────────────────────────"
  # "合计" 显示宽 4，日期列宽 12 -> 补 8 空格（同表头，不用 %-12s 免踩 CJK 宽度）
  awk -F'|' '{q+=$2;a+=$3;s+=$4;n+=$6}
    END{printf "  合计         %8d %8d %8d %8s %8d\n",q,a,s,"—",n}' <<<"$rows"

  echo
  echo "  ${c_bold}每日提问量${c_rst}"
  awk -F'|' '{print $1"|"$2}' <<<"$rows" | vbar 9
  echo
  printf "  ${c_bold}趋势${c_rst}  新会话 %s\n" "$(awk -F'|' '{print $4}' <<<"$rows" | spark)"
  printf "        活跃用户 %s\n" "$(awk -F'|' '{print $5}' <<<"$rows" | spark)"
}

# ---- 图表辅助（纯 awk/gawk，无外部依赖）----
# hbar: stdin 每行 "label|value[|display]"，画横向条形图（按最大值归一）
hbar() {
  local width="${1:-42}" label_w="${2:-18}"
  awk -F'|' -v W="$width" -v LW="$label_w" '
    # 显示宽度：非 ASCII 一律按双宽算（标签里只会有中文/数字，够用）；
    # gawk 在 UTF-8 locale 下 substr/length 按字符计，故可逐字符累加。
    # 按显示宽度截断到 n 列，右侧补空格
    function fit(s,n,   i,w,c,cw,o) { o=""; w=0
      for (i=1;i<=length(s);i++) { c=substr(s,i,1); cw=(c ~ /^[\x00-\x7F]$/)?1:2
        if (w+cw>n) break; o=o c; w+=cw }
      while (w++<n) o=o " "
      return o }
    { lab[NR]=$1; val[NR]=$2+0; disp[NR]=($3==""?$2:$3); if ($2+0>max) max=$2+0; n=NR }
    END {
      if (n==0) { print "    (无数据)"; exit }
      split("▏▎▍▌▋▊▉",f,"")
      for (i=1;i<=n;i++) {
        cells=(max>0)? val[i]*W/max : 0
        full=int(cells); bar=""
        for (j=0;j<full;j++) bar=bar "█"
        frac=cells-full
        if (frac>0.10) { k=int(frac*8)+1; if(k>7)k=7; bar=bar f[k] }
        printf "    %s %9s  %s\n", fit(lab[i], LW), disp[i], bar
      }
    }'
}

# vbar: stdin 每行 "xlabel|value"（按时间正序），画纵向柱状图；xlabel 取末 2 字符
vbar() {
  local height="${1:-9}"
  awk -F'|' -v H="$height" '
    { lab[NR]=$1; val[NR]=$2+0; if ($2+0>max) max=$2+0; n=NR }
    END {
      if (n==0) { print "    (无数据)"; exit }
      if (max<=0) max=1
      for (r=H;r>=1;r--) {
        line=""
        for (i=1;i<=n;i++) {
          cells=val[i]*H/max
          c=(cells>=r-0.25)? "█" : ((cells>=r-0.72)? "▄" : " ")
          line=line " " c " "
        }
        ytick=""
        if (r==H) ytick=sprintf("%d",max)
        else if (r==int((H+1)/2)) ytick=sprintf("%d",int(max/2))
        else if (r==1) ytick="0"
        printf "  %6s│%s\n", ytick, line
      }
      ax=""; for(i=1;i<=n;i++) ax=ax "───"
      printf "  %6s└%s\n", "", ax
      lb=""; for(i=1;i<=n;i++) lb=lb sprintf("%3s", substr(lab[i],length(lab[i])-1))
      printf "  %6s %s\n", "", lb
    }'
}

# spark: stdin 每行 "value"，输出单行迷你折线（sparkline）
spark() {
  awk '{v[NR]=$1+0; if($1+0>max)max=$1+0; n=NR}
       END{ if(n==0){printf "(无数据)\n"; exit}
            split("▁▂▃▄▅▆▇█",s,"")
            out=""
            for(i=1;i<=n;i++){ k=(max>0)? int(v[i]*7/max)+1 : 1; if(v[i]==0)k=1; out=out s[k] }
            printf "%s\n", out }'
}

# ---- 维护模式 ----
_reload_nginx_verify() {
  # 校验 -> reload -> 等 worker 接管（reload 是平滑重载，旧 worker draining，
  # 紧跟其后的探测可能命中旧 worker，见 operations.md 第 9 节踩坑记录）-> 验证
  as_root nginx -t
  as_root systemctl reload nginx
  sleep 3
}

maintenance_on() {
  is_maintenance && { echo "已经是维护模式，无需重复操作。"; return 0; }
  [[ -f "$MAINT_HTML_DIR/maintenance.html" ]] || die "维护页缺失：$MAINT_HTML_DIR/maintenance.html"

  local ts; ts=$(date +%Y%m%d-%H%M%S)
  local bak="${NGINX_SITE}.bak.pre-maintenance.${ts}"
  as_root cp -a "$NGINX_SITE" "$bak"
  # 记一个稳定的“正常配置”快照，供 off 恢复（始终指向最近一次正常态）
  as_root cp -a "$NGINX_SITE" "${NGINX_SITE}.normal"
  echo "已备份正常配置 -> $bak（并更新 .normal 快照）"

  # 从 live 配置动态生成维护版：把 HTTPS server 里的反代 location / 整块替换成 503。
  # 用 awk 状态机：进入 `location / {` 到其配对 `}` 之间全部丢弃，替换为维护块。
  local tmp; tmp=$(mktemp)
  as_root awk -v mhtml="$MAINT_HTML_DIR" '
    BEGIN{depth=0; inloc=0; done=0}
    # 侦测反代 location / 的开始（顶层，含 proxy 段）
    !done && $0 ~ /^[[:space:]]*location[[:space:]]+\/[[:space:]]*\{/ {
      inloc=1; depth=1;
      print "    # ===== 维护模式：所有请求返回 503 + 维护页（harness-ctl maintenance on 生成）=====";
      print "    location = /maintenance.html {";
      print "        root " mhtml ";";
      print "        internal;";
      print "        charset utf-8;";
      print "    }";
      print "    error_page 503 /maintenance.html;";
      print "    location / {";
      print "        return 503;";
      print "    }";
      next
    }
    inloc {
      n=gsub(/\{/,"{"); depth+=n;
      m=gsub(/\}/,"}"); depth-=m;
      if(depth<=0){inloc=0; done=1}
      next
    }
    {print}
  ' "$NGINX_SITE" > "$tmp"

  if ! grep -qE '^\s*return 503' "$tmp"; then
    rm -f "$tmp"; die "生成维护配置失败（没找到反代 location / 块）。未改动任何东西。"
  fi
  as_root cp "$tmp" "$NGINX_SITE"; rm -f "$tmp"

  # 守卫：reload 前先 nginx -t，失败则自动回滚到 .normal，绝不 reload 坏配置
  if ! as_root nginx -t 2>/dev/null; then
    as_root cp -a "${NGINX_SITE}.normal" "$NGINX_SITE"
    die "生成的维护配置 nginx -t 未通过，已自动回滚到正常配置（未 reload，线上不受影响）。"
  fi
  _reload_nginx_verify
  local code; code=$(http_code "$PUBLIC_URL")
  local back; back=$(http_code "$BACKEND_HEALTH")
  if [[ "$code" == "503" ]]; then
    echo "${c_grn}✔ 维护页已上线${c_rst}：对外 :443 -> $code，后端 :9090 -> $back（后端未动）"
    echo "  恢复：harness-ctl maintenance off"
  else
    err "预期对外 503，实际 $code —— 请检查 nginx。备份在 $bak"
    return 1
  fi
}

maintenance_off() {
  is_maintenance || { echo "当前不是维护模式，无需操作。对外 :443 -> $(http_code "$PUBLIC_URL")"; return 0; }
  local src
  if [[ -f "${NGINX_SITE}.normal" ]]; then
    src="${NGINX_SITE}.normal"
  else
    # 退路：找最近一次 pre-maintenance 备份
    src=$(as_root bash -c "ls -1t ${NGINX_SITE}.bak.pre-maintenance.* 2>/dev/null | head -1" || true)
    [[ -n "$src" ]] || die "找不到正常配置快照（.normal 或 .bak.pre-maintenance.*），无法自动恢复。请手动改回 proxy_pass。"
    echo "${c_yel}未找到 .normal 快照，改用最近备份：$src${c_rst}"
  fi
  as_root cp -a "$src" "$NGINX_SITE"
  _reload_nginx_verify
  local code; code=$(http_code "$PUBLIC_URL")
  local api; api=$(http_code "https://127.0.0.1/api/healthz")
  if [[ "$code" == "200" ]]; then
    echo "${c_grn}✔ 服务已恢复上线${c_rst}：对外 :443 -> $code，/api -> $api"
  else
    err "预期对外 200，实际 $code —— 请检查 nginx（源: $src）"
    return 1
  fi
}

cmd_maintenance() {
  case "${1:-}" in
    on)     maintenance_on ;;
    off)    maintenance_off ;;
    status|"") if is_maintenance; then echo "${c_yel}维护模式：ON${c_rst}"; else echo "${c_grn}维护模式：OFF（正常）${c_rst}"; fi ;;
    *)      die "用法：harness-ctl maintenance on|off|status" ;;
  esac
}

# drain 用：统计「真正在跑」的活跃 session。判据用沙箱心跳新鲜度（同 zombies 命令），
# 规避 orchestrator maintenance 循环无条件自续租 lease 造成的「假活跃」——否则一个僵尸
# session 会让 drain 循环永远等不到归零。回显四个数：live zombie unknown queued。
#   live    = running_active + 有 inflight turn + 心跳新鲜（这些才是要等它跑完的）
#   zombie  = running_active + 有 inflight turn + 心跳失联（永不自己结束，drain 不等它）
#   unknown = 有 inflight turn 但拿不到心跳（无资源/无心跳文件，需人工排查，drain 不等）
#   queued  = 排队中、尚未开跑的 turn（重启不会丢，会被重新领取；仅作提示）
count_live_active() {
  local now_epoch; now_epoch=$(date -u +%s)
  local rows
  rows=$(dbq "SELECT s.id, COALESCE(r.bridge_dir_path,''),
                     (SELECT COUNT(*) FROM turns t
                        WHERE t.session_id=s.id AND t.status IN ($INFLIGHT_STATES))
              FROM sessions s
              LEFT JOIN runtime_resource_instances r
                     ON r.generation_id = s.active_generation_id
              WHERE s.status='running_active';")
  local live=0 zombie=0 unknown=0
  while IFS='|' read -r sid bridge inflight; do
    [[ -z "$sid" ]] && continue
    [[ -z "$inflight" || "$inflight" == "0" ]] && continue   # 无在途 turn，不用等
    if [[ -z "$bridge" ]]; then unknown=$((unknown+1)); continue; fi
    local m; m=$(file_mtime "$bridge/heartbeat/bridge")
    if [[ -z "$m" ]]; then unknown=$((unknown+1)); continue; fi
    if (( now_epoch - m > ZOMBIE_STALL_SECS )); then zombie=$((zombie+1)); else live=$((live+1)); fi
  done <<< "$rows"
  local queued; queued=$(dbq "SELECT COUNT(*) FROM turns WHERE status='queued';")
  echo "$live $zombie $unknown ${queued:-0}"
}

# ---- 命令：safe-restart ----
# 固定流程（无开关）：上维护页挡新流量 → 循环等活跃对话跑完 → 重启 → 自动下维护页。
# 维护页的上/下是强制的，不再可选：restart 一律零打断进行。
DRAIN_TIMEOUT="${DRAIN_TIMEOUT:-900}"   # drain 最长等待秒数（默认 15 分钟）
DRAIN_INTERVAL="${DRAIN_INTERVAL:-5}"   # drain 轮询间隔秒数
cmd_safe_restart() {
  local force=0 svc=""
  for a in "$@"; do
    case "$a" in
      --force) force=1 ;;
      --timeout=*) DRAIN_TIMEOUT="${a#*=}" ;;
      --interval=*) DRAIN_INTERVAL="${a#*=}" ;;
      *) svc="$a" ;;
    esac
  done
  [[ -n "$svc" ]] || die "用法：harness-ctl safe-restart <service> [--timeout=秒] [--interval=秒] [--force]
  可选服务：harness-publish-orchestrator | harness-publish-frontend
  固定流程：上维护页 → 等活跃对话跑完 → 重启 → 下维护页（维护页强制，不可关闭）
  --timeout=秒   drain 最长等待（默认 ${DRAIN_TIMEOUT}s），超时不重启（除非 --force）
  --force        超时后无视残留活跃对话强制重启"
  case "$svc" in
    harness-publish-orchestrator|harness-publish-frontend) ;;
    *) die "只允许重启 harness-publish-orchestrator / harness-publish-frontend（其它服务请手动确认）" ;;
  esac

  # ---- 强制先上维护页挡新流量（结束后自动恢复；若本来就在维护态则不动它）----
  local maint_was_on=0
  is_maintenance && maint_was_on=1
  if [[ "$maint_was_on" -eq 0 ]]; then
    echo "上维护页，挡住新对话进来（重启后自动恢复）..."
    maintenance_on || die "上维护页失败，已中止（未重启）。"
  else
    echo "${c_dim}已处于维护模式，沿用现状（重启后不改动维护页）。${c_rst}"
  fi

  local deadline=$(( $(date -u +%s) + DRAIN_TIMEOUT ))
  local live zombie unknown queued done=0
  echo "开始 drain：等心跳新鲜的活跃对话跑完（每 ${DRAIN_INTERVAL}s 查一次，最长 ${DRAIN_TIMEOUT}s）..."
  while :; do
    read -r live zombie unknown queued <<< "$(count_live_active)"
    local remain=$(( deadline - $(date -u +%s) ))
    printf "\r  活跃(等待中)=%s  排队=%s  僵尸(不等)=%s  待排查=%s  剩余=%ss   " \
      "$live" "$queued" "$zombie" "$unknown" "$((remain>0?remain:0))"
    if [[ "$live" -eq 0 && "$queued" -eq 0 ]]; then done=1; break; fi
    if (( remain <= 0 )); then break; fi
    sleep "$DRAIN_INTERVAL"
  done
  echo   # 收掉 \r 行

  if [[ "$done" -ne 1 ]]; then
    err "drain 超时（${DRAIN_TIMEOUT}s）仍有 活跃=${live} 排队=${queued}。"
    [[ "$zombie" -gt 0 ]] && echo "  ${c_yel}有 ${zombie} 个僵尸 session（沙箱失联，永不自结束）——它们不会随 drain 消失，见: harness-ctl zombies${c_rst}"
    if [[ "$force" -ne 1 ]]; then
      echo "  强制重启（会打断上述活跃对话）：加 --force"
      [[ "$maint_was_on" -eq 0 ]] && { echo "  回退维护页..."; maintenance_off || true; }
      return 2
    fi
    echo "${c_yel}--force：无视残留活跃对话，继续重启${c_rst}"
  else
    echo "${c_grn}活跃对话已全部跑完，可安全重启。${c_rst}"
    [[ "$zombie" -gt 0 ]] && echo "  ${c_dim}（另有 ${zombie} 个僵尸 session 被跳过，重启正好清理它们）${c_rst}"
  fi

  echo "重启 $svc ..."
  as_root systemctl restart "$svc"
  sleep 2
  echo "状态：$(systemctl is-active "$svc")  后端健康：$(http_code "$BACKEND_HEALTH")"
  if [[ "$maint_was_on" -eq 0 ]]; then
    echo "下维护页，恢复对外服务..."
    maintenance_off || err "下维护页失败！请手动执行 harness-ctl maintenance off"
  else
    echo "${c_dim}进入前已是维护模式，保持维护页不动（如需恢复：harness-ctl maintenance off）。${c_rst}"
  fi
}

usage() {
  cat <<'EOF'
harness-ctl — publish 环境运维 CLI

用法：
  harness-ctl status                服务/入口/在途对话 一屏总览
  harness-ctl inflight              列出正在进行的 turn（含归属用户、会话标题、时长、僵尸 lease 标注）
  harness-ctl zombies               扫描僵尸/状态漂移 session + maintenance 循环卡死
  harness-ctl traffic [N]           汇总最近 N 行 nginx 流量（默认 5000）
  harness-ctl stats [天数]          每日提问/会话/用户新增表 + 柱状图（默认 14 天）
  harness-ctl users [N] [--by=…]    用户维度用量与存储 Top N（--by=msgs|storage|sessions）
  harness-ctl user list             列出登录账号（不打印哈希）
  harness-ctl user add <名>         新增登录账号（交互式输入密码）
  harness-ctl user passwd <名>      改密码（默认吊销该账号已有 cookie）
  harness-ctl user rm <名>          删除登录账号（删最后一个需 --force）
                                    以上四条改完立即生效，无需重启、无需维护页
  harness-ctl storage [N]           存储总览：按目录 + Top N 会话占用
  harness-ctl kb status             知识库：当前上线快照 / 待审批快照 + 增删改计数
  harness-ctl kb diff               待审批快照与线上快照逐文件 diff
  harness-ctl kb approve <digest>   批准上线（原子 repoint，只影响新会话）
  harness-ctl kb reject <digest>    驳回（--reason 记原因，不动线上）
                                    夜间自进化只暂存不上线，靠这四条人工放行
  harness-ctl kb reseed [--path …]  用仓库种子树修正人工种入的文件，暂存待审批
                                    （蒸馏管线不会重写这类文件，只会原样复制）
  harness-ctl maintenance on        上维护页（nginx 503，后端不动）
  harness-ctl maintenance off       下维护页，恢复服务
  harness-ctl maintenance status    只看维护模式开关
  harness-ctl safe-restart <svc>    零打断重启：上维护页→等活跃对话跑完→重启→下维护页
                                    （--timeout=秒 调等待上限，--force 超时也强制重启）

服务名：harness-publish-orchestrator | harness-publish-frontend
环境变量：HARNESS_DATA_ROOT / HARNESS_DB 可将诊断指向 dev/staging 数据根目录。
详见 docs/operations.md 第 9 节。
EOF
}

main() {
  need_deps
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    status)       cmd_status ;;
    inflight)     cmd_inflight ;;
    zombies)      cmd_zombies ;;
    traffic)      cmd_traffic "$@" ;;
    stats|usage)  cmd_stats "$@" ;;
    users)        cmd_users "$@" ;;
    user)         cmd_user "$@" ;;
    storage|disk) cmd_storage "$@" ;;
    kb)           cmd_kb "$@" ;;
    maintenance|maint) cmd_maintenance "$@" ;;
    safe-restart) cmd_safe_restart "$@" ;;
    -h|--help|help|"") usage ;;
    *) err "未知命令：$cmd"; usage; exit 1 ;;
  esac
}
main "$@"
