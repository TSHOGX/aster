{
  "label": "Example deployment",
  "config": "/etc/harness/example/harness.yaml",
  "environment": {
    "HARNESS_ORCHESTRATOR_ADDR": "127.0.0.1:9090",
    "HARNESS_API_BASE_URL": "http://127.0.0.1:9090",
    "HARNESS_DB_PATH": "/var/lib/harness/example/state/orchestrator.db",
    "HARNESS_MEMORY_DB_PATH": "/var/lib/harness/example/state/memory.db",
    "HARNESS_AUTH_USERS_PATH": "/etc/harness/example/auth-users.yaml",
    "HARNESS_AGENTS_KB_PATH": "/var/lib/harness/example/agents-kb",
    "HARNESS_TRAJECTORY_ROOT": "/var/lib/harness/example/trajectories",
    "HARNESS_AGENT_HOMES_ROOT": "/var/lib/harness/example/agent-homes",
    "HARNESS_SESSIONS_ROOT": "/var/lib/harness/example/sessions",
    "HARNESS_CHECKPOINTS_ROOT": "/var/lib/harness/example/checkpoints",
    "HARNESS_BUNDLE_ROOT": "/var/lib/harness/example/bundles",
    "HARNESS_SHARE_BLOB_ROOT": "/var/lib/harness/example/state/share-blobs",
    "RUNSC_ROOT": "/var/lib/harness/example/runsc",
    "EVOLUTION_PROJECT_ROOT": "/opt/trajectory-evolve",
    "EVOLUTION_STATE_ROOT": "/var/lib/harness/example/evolution",
    "EVOLUTION_MEMORY_DB": "/var/lib/harness/example/state/memory.db",
    "EVOLUTION_BUN": "/opt/trajectory-evolve/node_modules/.bin/bun",
    "PORT": "9001",
    "HOSTNAME": "127.0.0.1",
    "HARNESS_RUN_DIR": "/var/lib/harness/example/run"
  },
  "releases": "/opt/harness/releases",
  "rootfs": "/opt/harness/rootfs",
  "cache": "/var/cache/harness/releases",
  "operations": "/var/lib/harness-deploy/example",
  "current": "/opt/harness/instances/example/current",
  "backend_service": "harness-orchestrator@example.service",
  "frontend_service": "harness-frontend@example.service",
  "frontend_user": "harness-web",
  "external_writers": [
    "harness-evolution@example.service",
    "harness-nightly@example.timer"
  ],
  "writers_inventoried": false,
  "backup_paths": [
    "/var/lib/harness/example",
    "/etc/harness/example"
  ],
  "backups": "/var/backups/harness/example",
  "maintenance_file": "/run/harness-deploy/example/maintenance",
  "drain_file": "/run/harness-deploy/example/drain",
  "background_hold_file": "/run/harness-deploy/example/background-hold",
  "backend_health": "http://127.0.0.1:9090/healthz",
  "frontend_health": "http://127.0.0.1:9001/",
  "proxy_health": "http://127.0.0.1:8083/healthz",
  "resolver": "/etc/harness/example/resolv.conf",
  "smoke_command": [
    "/etc/harness/example/hooks/smoke"
  ],
  "external_idle_command": [
    "/etc/harness/example/hooks/external-idle"
  ],
  "cold_start_command": [
    "/etc/harness/example/hooks/cold-start"
  ],
  "drain_seconds": 1800,
  "previous_release": "",
  "legacy_binary_sha256": "",
  "frontend_build_id_file": ""
}
