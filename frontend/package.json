{
  "name": "agent-runtime-frontend",
  "private": true,
  "scripts": {
    "predev": "node scripts/patch-office-viewers.mjs",
    "prebuild": "node scripts/patch-office-viewers.mjs",
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "npm run build && npm run test:ui:built",
    "test:ui:built": "playwright test --config playwright.ui.config.ts",
    "test:pickers": "npm run build && playwright test --config playwright.pickers.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@js-preview/excel": "^1.7.14",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/postcss": "^4.1.14",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "docx-preview": "^0.4.0",
    "highlight.js": "^11.10.0",
    "lucide-react": "^0.460.0",
    "next": "^16.2.6",
    "pptx-preview": "^1.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "saxes": "6.0.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.17.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.4.47",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "pptx-preview": {
      "echarts": "^6.1.0",
      "uuid": "^11.1.1"
    }
  }
}
