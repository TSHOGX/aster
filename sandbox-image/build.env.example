# Optional builder-only inputs. Copy to build.env or set SANDBOX_BUILD_ENV.
# These inputs affect fetching in the disposable build environment; the Project
# overwrites guest hosts/resolver files from its saved reachability declaration.
#UBUNTU_MIRROR=https://mirror.example.invalid/ubuntu-ports
#PIP_INDEX_URL=https://mirror.example.invalid/pypi/simple
#NPM_REGISTRY=https://registry.npmjs.org
#NODE_DIST_BASE_URL=https://nodejs.org/dist
#BUILD_DNS_SERVERS="192.0.2.53"
# An optional operator-reviewed executable receives the build root as argument 1.
#SANDBOX_BUILD_DNS_HOOK=/srv/build/configure-dns
