#!/usr/bin/env python3
import argparse
import collections
import fcntl
import json
import os
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path


INBOX = "inbox"
OUTBOX = "outbox"
HEARTBEAT = "heartbeat"
HOST_HEARTBEAT_DIR = "host-heartbeat"
TMP = "tmp"
BRIDGE_HEARTBEAT = "bridge"
HOST_HEARTBEAT = "host"
CHECKPOINT_READY = "checkpoint-ready"
# Host → sandbox control for the turn that is executing right now (abort/steer).
#
# It cannot travel as a normal bridge message: the bridge is request/response,
# the sandbox is the only requester, and during a turn nothing is polling the
# inbox — the turn thread is blocked reading pi. So the host drops a single
# JSON file here and a watcher thread reads it.
#
# It lives in the inbox directory, which is already mounted read-only into the
# sandbox, and its name is deliberately NOT a seq name: both queue readers accept
# only the fixed-width `00000000000000000001.json` form, and the host's response
# prune only ever deletes seq-named files. So this file is invisible to the queue
# machinery and safe from its cleanup, with no new mount and no contract change.
TURN_CONTROL_FILE = "turn-control.json"
TURN_CONTROL_COMMANDS = frozenset({"abort", "steer"})
# Schema version of that file, shared with the host writer
# (orchestrator/internal/bridge/turncontrol.go). Anything else is refused rather
# than guessed at, so a host and a rootfs that disagree fail visibly instead of
# dropping the user's Stop.
TURN_CONTROL_VERSION = 1
PI_CODING_AGENT_DIR = "/root/.pi/agent" if os.environ.get("HARNESS_BACKEND") == "khora" else "/agent-home/.pi/agent"
PI_SESSION_DIR = f"{PI_CODING_AGENT_DIR}/sessions"
PI_MODELS_SANDBOX_PATH = f"{PI_CODING_AGENT_DIR}/models.json"
PI_SETTINGS_SANDBOX_PATH = f"{PI_CODING_AGENT_DIR}/settings.json"
PI_HARNESS_PROXY_PROVIDER = "harness_anthropic_proxy"
PI_SYSTEM_PROMPT_PATH = "/usr/local/share/harness/pi-system-prompt.md"
DRIVER_STATE_DIGEST_PREFIX = b"driver_state_digest_v1\n"
# Consecutive claim failures before the claim loop gives up. With the 1s-per-
# failure backoff (capped at 10s) and a 30s timeout, 20 failures is on the order
# of ten minutes of a host that never answers — long past the host's own lease
# recovery, so by then the generation has been retired anyway.
DEFAULT_MAX_CLAIM_FAILURES = 20


def seq_name(seq):
    return f"{seq:020d}.json"


def parse_seq_name(name):
    if len(name) != len("00000000000000000001.json") or not name.endswith(".json"):
        return None
    raw = name[:-5]
    if not raw.isdigit():
        return None
    seq = int(raw, 10)
    if seq <= 0 or seq_name(seq) != name:
        return None
    return seq


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_heartbeat(root, name):
    if name not in {BRIDGE_HEARTBEAT, HOST_HEARTBEAT}:
        raise ValueError(f"unsupported heartbeat file {name}")
    dirname = HOST_HEARTBEAT_DIR if name == HOST_HEARTBEAT else HEARTBEAT
    write_control_file(root, dirname, name, ".heartbeat")


def write_checkpoint_ready(root):
    write_control_file(root, HEARTBEAT, CHECKPOINT_READY, ".ready")


def clear_checkpoint_ready(root):
    ready = Path(root) / HEARTBEAT / CHECKPOINT_READY
    try:
        ready.unlink()
        fsync_dir(ready.parent)
    except FileNotFoundError:
        pass


def write_control_file(root, dirname, name, suffix):
    root = Path(root)
    tmp = root / TMP
    target_dir = root / dirname
    tmp.mkdir(parents=True, exist_ok=True)
    target_dir.mkdir(parents=True, exist_ok=True)
    tmp_path = tmp / f"{uuid.uuid4()}{suffix}"
    with open(tmp_path, "xb") as f:
        f.write(f"{time.time_ns()}\n".encode("ascii"))
        f.flush()
        os.fsync(f.fileno())
    try:
        os.replace(tmp_path, target_dir / name)
        fsync_dir(target_dir)
    finally:
        try:
            tmp_path.unlink()
        except FileNotFoundError:
            pass


def read_turn_control(root):
    """Read the host's turn-control log: an ordered list of commands.

    A log rather than a single slot because this is polled every few hundred ms.
    Two commands written inside one interval would leave only the second in a
    single-slot file, and for steer that is a message the user typed — silently
    dropped while the host has already reported it delivered. Every entry the
    watcher has not applied yet is still here when it next looks.

    Tolerant by construction: the host replaces the file with an atomic rename,
    so a missing, half-visible or malformed file is an ordinary observation rather
    than a fault. Anything unparseable yields an empty list and is simply retried
    — this must never raise into the watcher thread, because that thread runs
    inside the sandbox's init process.

    Entries missing a token or turn_id are skipped, not fatal: the token lets the
    watcher ignore one it has already applied, and the turn_id keeps a stale
    command from reaching a later turn that happens to be running when it is
    finally noticed. Skipping one bad entry still delivers the good ones around
    it.
    """
    path = Path(root) / INBOX / TURN_CONTROL_FILE
    try:
        with open(path, "r", encoding="utf-8") as f:
            payload = json.load(f)
    except (FileNotFoundError, NotADirectoryError, PermissionError, json.JSONDecodeError, UnicodeDecodeError, OSError):
        return []
    if not isinstance(payload, dict) or payload.get("version") != TURN_CONTROL_VERSION:
        return []
    raw_commands = payload.get("commands")
    if not isinstance(raw_commands, list):
        return []
    commands = []
    for entry in raw_commands:
        if not isinstance(entry, dict):
            continue
        command = str(entry.get("command") or "")
        if command not in TURN_CONTROL_COMMANDS:
            continue
        token = str(entry.get("token") or "")
        if not token:
            continue
        try:
            turn_id = int(entry.get("turn_id"))
        except (TypeError, ValueError):
            continue
        commands.append(
            {
                "command": command,
                "token": token,
                "turn_id": turn_id,
                "message": str(entry.get("message") or ""),
            }
        )
    return commands


def canonical_json_bytes(payload):
    return json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")


def driver_state_digest(payload):
    import hashlib

    return "sha256:" + hashlib.sha256(DRIVER_STATE_DIGEST_PREFIX + canonical_json_bytes(payload)).hexdigest()


class Queue:
    def __init__(self, root, name):
        self.root = Path(root)
        self.name = name
        self.dir = self.root / name
        self.tmp = self.root / TMP
        self.tmp.mkdir(parents=True, exist_ok=True)
        self.dir.mkdir(parents=True, exist_ok=True)

    def next_seq(self):
        max_seq = 0
        for entry in self.dir.iterdir():
            seq = parse_seq_name(entry.name)
            if seq is not None and seq > max_seq:
                max_seq = seq
        return max_seq + 1

    def write(self, envelope):
        envelope = dict(envelope)
        envelope.setdefault("message_id", str(uuid.uuid4()))
        payload = (json.dumps(envelope, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
        tmp_path = self.tmp / f"{uuid.uuid4()}.json"
        with open(tmp_path, "xb") as f:
            f.write(payload)
            f.flush()
            os.fsync(f.fileno())
        try:
            while True:
                target = self.dir / seq_name(self.next_seq())
                try:
                    os.link(tmp_path, target)
                    fsync_dir(self.dir)
                    return envelope["message_id"]
                except FileExistsError:
                    continue
        finally:
            try:
                tmp_path.unlink()
            except FileNotFoundError:
                pass

    def read_all(self, min_seq=0):
        """List readable messages with seq > min_seq, oldest first.

        A file that is listed by iterdir but gone (or not yet complete) by the
        time it is opened is skipped, not raised. The host prunes stale inbox
        responses on its own schedule and this directory is read-only to the
        sandbox, so a vanishing entry is an ordinary event here — and an
        uncaught one used to take the whole claim loop, i.e. the sandbox, down.
        """
        files = []
        for entry in self.dir.iterdir():
            seq = parse_seq_name(entry.name)
            if seq is None or seq <= min_seq:
                continue
            try:
                with open(entry, "r", encoding="utf-8") as f:
                    files.append((seq, entry, json.load(f)))
            except (FileNotFoundError, json.JSONDecodeError, UnicodeDecodeError):
                continue
        return sorted(files, key=lambda item: item[0])

    def unlink(self, path):
        try:
            Path(path).unlink()
            fsync_dir(self.dir)
        except (FileNotFoundError, PermissionError):
            pass


def args_driver_id(args):
    driver_id = (getattr(args, "driver_id", "") or "").strip()
    if not driver_id:
        raise RuntimeError("--driver-id is required")
    return driver_id


class BridgeClient:
    def __init__(self, root, session_id, generation_id, driver_id, poll_interval=0.05):
        self.root = Path(root)
        self.session_id = session_id
        self.generation_id = generation_id
        self.driver_id = (driver_id or "").strip()
        if not self.driver_id:
            raise RuntimeError("driver_id is required")
        self.poll_interval = poll_interval
        self.inbox = Queue(root, INBOX)
        self.outbox = Queue(root, OUTBOX)
        self.last_output_sequence_by_turn = {}
        self.leased_turn_id = None
        self._producer_lock_fd = None
        # Highest inbox sequence already consumed. The inbox is host-owned and
        # mounted read-only, so responses cannot be unlinked from this side;
        # the host writes them with a monotonic sequence and prunes old ones
        # itself. Tracking the high-water mark means a response is opened
        # once, and stale ones are never opened at all.
        self.inbox_seen_seq = 0

    def acquire_producer_lock(self):
        """Ensure only one claim-loop process can produce turn output.

        The bridge directory survives process restarts.  Without a producer
        fence, a stale client and its replacement can emit the same logical
        output sequence concurrently, which the host must (correctly) reject
        as a protocol corruption.  flock is released automatically if the
        process dies, so a crash never leaves a permanent lockout.
        """
        if self._producer_lock_fd is not None:
            return
        lock_path = self.root / TMP / "producer.lock"
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as err:
            os.close(fd)
            raise RuntimeError("another bridge producer is already running") from err
        self._producer_lock_fd = fd

    def release_producer_lock(self):
        fd, self._producer_lock_fd = self._producer_lock_fd, None
        if fd is None:
            return
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)

    def envelope(self, message_type, request_id=None, turn_id=None, payload=None):
        envelope = {
            "message_id": str(uuid.uuid4()),
            "request_id": request_id or str(uuid.uuid4()),
            "type": message_type,
            "session_id": self.session_id,
            "generation_id": self.generation_id,
        }
        if turn_id is not None:
            envelope["turn_id"] = turn_id
        if payload is not None:
            envelope["payload"] = payload
        return envelope

    def send(self, message_type, request_id=None, turn_id=None, payload=None):
        envelope = self.envelope(message_type, request_id=request_id, turn_id=turn_id, payload=payload)
        self.outbox.write(envelope)
        return envelope

    def wait_response(self, request_id, timeout=None):
        deadline = None if timeout is None else time.monotonic() + timeout
        while True:
            for seq, _, envelope in self.inbox.read_all(min_seq=self.inbox_seen_seq):
                # Only one request is ever outstanding, so every newer response
                # that is not ours answers a request we already gave up on
                # (a timeout). Consume it and move on.
                self.inbox_seen_seq = max(self.inbox_seen_seq, seq)
                if envelope.get("request_id") != request_id:
                    continue
                if envelope.get("type") == "error":
                    payload = envelope.get("payload") or {}
                    raise RuntimeError(payload.get("error") or "bridge error")
                return envelope
            if deadline is not None and time.monotonic() >= deadline:
                raise TimeoutError(f"timed out waiting for {request_id}")
            time.sleep(self.poll_interval)

    def hello(self, timeout=None):
        request_id = str(uuid.uuid4())
        self.send(
            "hello",
            request_id=request_id,
            payload={"driver_id": self.driver_id, "protocol_version": 2, "turn_input_schema": "RunTurn"},
        )
        response = self.wait_response(request_id, timeout=timeout)
        payload = response.get("payload") or {}
        self.last_output_sequence_by_turn = {
            int(turn_id): int(sequence)
            for turn_id, sequence in (payload.get("last_output_sequence_by_turn") or {}).items()
        }
        # The host acknowledgement only includes events already committed to
        # SQLite.  A crash/reconnect can leave durable emit_output files in the
        # sandbox outbox that have not been consumed yet.  Include those files
        # in the resume boundary so a replacement producer never reuses a
        # sequence that is already pending on disk.
        for _, _, pending in self.outbox.read_all():
            if pending.get("type") != "emit_output":
                continue
            turn_id = pending.get("turn_id")
            pending_payload = pending.get("payload") or {}
            sequence = pending_payload.get("output_sequence")
            if turn_id is None or sequence is None:
                continue
            try:
                turn_id = int(turn_id)
                sequence = int(sequence)
            except (TypeError, ValueError):
                continue
            self.last_output_sequence_by_turn[turn_id] = max(
                self.last_output_sequence_by_turn.get(turn_id, 0), sequence
            )
        self.leased_turn_id = payload.get("leased_turn_id")
        return payload

    def probe_network(self, timeout=None):
        request_id = str(uuid.uuid4())
        self.send("probe_network", request_id=request_id)
        return self.wait_response(request_id, timeout=timeout).get("payload") or {}

    def heartbeat(self):
        self.touch_bridge_heartbeat()
        self.send("heartbeat")

    def touch_bridge_heartbeat(self):
        write_heartbeat(self.root, BRIDGE_HEARTBEAT)

    def mark_checkpoint_ready(self):
        write_checkpoint_ready(self.root)

    def clear_checkpoint_ready(self):
        clear_checkpoint_ready(self.root)

    def claim_next_turn(self, timeout=None):
        request_id = str(uuid.uuid4())
        self.send("claim_next_turn", request_id=request_id)
        response = self.wait_response(request_id, timeout=timeout)
        if response.get("type") != "grant":
            return None
        return response.get("payload") or {}

    def resume_turn(self, turn_id, timeout=None):
        request_id = str(uuid.uuid4())
        self.send("resume_turn", request_id=request_id, turn_id=turn_id)
        response = self.wait_response(request_id, timeout=timeout)
        if response.get("type") != "grant":
            return None
        return response.get("payload") or {}

    def ack_turn_started(self, turn_id, sandbox_source_ip):
        self.send("ack_turn_started", turn_id=turn_id, payload={"sandbox_source_ip": sandbox_source_ip})

    def emit_output(self, turn_id, output_sequence, payload, stream="stdout"):
        self.send(
            "emit_output",
            turn_id=turn_id,
            payload={"output_sequence": output_sequence, "stream": stream, "payload": payload},
        )

    def ack_turn_completed(self, turn_id, status="completed", error_class="", error="", driver_state_update=None):
        payload = {"status": status}
        if error_class:
            payload["error_class"] = error_class
        if error:
            payload["error"] = error
        if driver_state_update is not None:
            payload["driver_state_update"] = driver_state_update
        self.send("ack_turn_completed", turn_id=turn_id, payload=payload)


class StdioBridgeClient(BridgeClient):
    def __init__(self, root, session_id, generation_id, driver_id, poll_interval=0.05):
        sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
        import harness_stream
        self.root = Path(root)
        self.session_id = session_id
        self.generation_id = generation_id
        self.driver_id = driver_id
        self.poll_interval = poll_interval
        self.last_output_sequence_by_turn = {}
        self.leased_turn_id = None
        self.journal = harness_stream.Journal(root, generation_id)
        self.channel = harness_stream.StdioChannel(self.journal, sys.stdin.buffer, sys.stdout.buffer,
                                                 {"protocol_version": 2, "driver_id": driver_id, "turn_input_schema": "RunTurn"})

    def acquire_producer_lock(self):
        pass  # Journal acquired the execution's producer lock before reading stdin.

    def release_producer_lock(self):
        # The reader is daemon-scoped to this process. Closing stdin by the host
        # ends it; journal commits are already durable before each send returns.
        if not self.channel.reader.is_alive():
            self.journal.close()

    def send(self, message_type, request_id=None, turn_id=None, payload=None):
        envelope = self.envelope(message_type, request_id=request_id, turn_id=turn_id, payload=payload)
        self.channel.emit(envelope)
        return envelope

    def wait_response(self, request_id, timeout=None):
        return self.channel.wait_response(request_id, timeout)

    def hello(self, timeout=None):
        request = self.send("hello", payload={"protocol_version": 2, "driver_id": self.driver_id, "turn_input_schema": "RunTurn"})
        response = self.wait_response(request["request_id"], timeout)
        if response.get("type") != "hello_ack":
            raise RuntimeError("bridge hello acknowledgment required")
        payload = response.get("payload") or {}
        self.last_output_sequence_by_turn = {int(turn): int(sequence) for turn, sequence in (payload.get("last_output_sequence_by_turn") or {}).items()}
        self.leased_turn_id = payload.get("leased_turn_id")
        for turn, sequence in self.journal.output_watermarks().items():
            self.last_output_sequence_by_turn[turn] = max(sequence, self.last_output_sequence_by_turn.get(turn, 0))
        return payload

    def touch_bridge_heartbeat(self):
        pass

    def mark_checkpoint_ready(self):
        pass

    def clear_checkpoint_ready(self):
        pass

    def ack_turn_started(self, turn_id, sandbox_source_ip):
        self.send("ack_turn_started", turn_id=turn_id, payload={})

    def ack_turn_completed(self, turn_id, status="completed", error_class="", error="", driver_state_update=None):
        payload = {"status": status, "final_output_sequence": self.last_output_sequence_by_turn.get(turn_id, 0)}
        if error_class:
            payload["error_class"] = error_class
        if error:
            payload["error"] = error
        if driver_state_update is not None:
            payload["driver_state_update"] = driver_state_update
        self.send("ack_turn_completed", turn_id=turn_id, payload=payload)

    def start_control_watcher(self, runner, turn_id):
        stop = threading.Event()
        if not hasattr(runner, "deliver_control"):
            return stop
        def watch():
            while not stop.wait(0.02):
                for command in self.channel.take_controls(turn_id):
                    runner.deliver_control(command["command"], turn_id, command.get("message", ""))
        threading.Thread(target=watch, daemon=True).start()
        return stop


class ShellTurnRunner:
    def __init__(self):
        self.proc = None

    def _start(self):
        if self.proc is not None and self.proc.poll() is None:
            return
        self.proc = subprocess.Popen(
            ["/usr/local/bin/harness-shell-agent"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )

    def run_turn(self, content, emit):
        self._start()
        frame = json.dumps({"type": "turn", "content": content}, ensure_ascii=False, separators=(",", ":"))
        self.proc.stdin.write(frame + "\n")
        self.proc.stdin.flush()
        while True:
            line = self.proc.stdout.readline()
            if line == "":
                raise RuntimeError("shell agent exited before turn completed")
            stripped = line.rstrip("\n")
            try:
                payload = json.loads(stripped)
            except json.JSONDecodeError:
                emit("stdout", stripped)
                continue
            if payload.get("type") == "harness.turn_done":
                return "completed", "", ""
            emit("stdout", stripped)

    def close(self):
        if self.proc is None:
            return
        try:
            self.proc.terminate()
        except OSError:
            pass


def validate_pi_runtime_environment():
    required = {
        "PI_CODING_AGENT_DIR": PI_CODING_AGENT_DIR,
        "PI_CODING_AGENT_SESSION_DIR": PI_SESSION_DIR,
        "PI_OFFLINE": "1",
        "PI_SKIP_VERSION_CHECK": "1",
        "PI_TELEMETRY": "0",
    }
    for name, want in required.items():
        got = os.environ.get(name, "")
        if got != want:
            raise RuntimeError(f"{name} must be {want}")
    return required


def validate_pi_config_materialization():
    for path in (PI_MODELS_SANDBOX_PATH, PI_SETTINGS_SANDBOX_PATH):
        candidate = Path(path)
        reject_symlink_path_components(candidate, "pi config")
        try:
            st = candidate.stat()
        except OSError as err:
            raise RuntimeError(f"pi config missing: {path}") from err
        if not candidate.is_file():
            raise RuntimeError(f"pi config is not a regular file: {path}")
        if pi_config_writable_by_sandbox_uid(st):
            raise RuntimeError(f"pi config is writable by sandbox uid/gid: {path}")
        with open(candidate, "rb") as f:
            f.read(1)


def pi_config_writable_by_sandbox_uid(st):
    try:
        uid = int(os.environ.get("HARNESS_AGENT_UID", "65534"))
        gid = int(os.environ.get("HARNESS_AGENT_GID", "65534"))
    except ValueError:
        uid, gid = 65534, 65534
    mode = st.st_mode
    return bool(
        mode & 0o002
        or (st.st_uid == uid and mode & 0o200)
        or (st.st_gid == gid and mode & 0o020)
    )


def read_pi_system_prompt():
    path = Path(PI_SYSTEM_PROMPT_PATH)
    reject_symlink_path_components(path, "pi system prompt")
    try:
        st = path.stat()
    except FileNotFoundError:
        return ""
    except OSError as err:
        raise RuntimeError(f"pi system prompt stat failed: {path}") from err
    if not path.is_file():
        raise RuntimeError(f"pi system prompt is not a regular file: {path}")
    if pi_config_writable_by_sandbox_uid(st):
        raise RuntimeError(f"pi system prompt is writable by sandbox uid/gid: {path}")
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError as err:
        raise RuntimeError(f"pi system prompt read failed: {path}") from err


def pi_event_stop_reason(event):
    message = event.get("message")
    if isinstance(message, dict):
        return str(message.get("stopReason") or message.get("stop_reason") or "")
    return str(event.get("stopReason") or event.get("stop_reason") or "")


def reject_symlink_path_components(path, label):
    current = Path(path)
    for _ in range(4):
        if current.is_symlink():
            raise RuntimeError(f"{label} must not use sandbox symlink: {current}")
        parent = current.parent
        if parent == current:
            break
        current = parent


def normalize_pi_session_file(session_file):
    raw = str(session_file or "").strip()
    if not raw:
        raise RuntimeError("pi sessionFile is required")
    if "\\" in raw:
        raise RuntimeError("pi sessionFile must use POSIX separators")
    root = Path(PI_SESSION_DIR)
    reject_symlink_path_components(root, "pi session dir")
    candidate = Path(raw)
    if not candidate.is_absolute():
        candidate = root / candidate
    try:
        real_root = root.resolve(strict=True)
        real_candidate = candidate.resolve(strict=True)
    except OSError as err:
        raise RuntimeError(f"pi sessionFile realpath failed: {raw}") from err
    try:
        rel = real_candidate.relative_to(real_root)
    except ValueError as err:
        raise RuntimeError(f"pi sessionFile escapes session dir: {raw}") from err
    if str(rel) in {"", "."} or any(part in {"", ".", ".."} for part in rel.parts):
        raise RuntimeError(f"pi sessionFile has invalid relative path: {raw}")
    relpath = rel.as_posix()
    return relpath, str(root / relpath)


class PiRPCTurnRunner:
    def __init__(self):
        self.proc = None
        self.current_grant = {}
        self.restored_state_digest = ""
        self.stderr_tail = collections.deque(maxlen=20)
        self.stderr_lock = threading.Lock()
        # Guards writes to pi's stdin. The turn thread blocks in _read_rpc while
        # the control watcher writes abort/steer from another thread, so the two
        # would otherwise interleave partial JSON lines into the same pipe.
        self.stdin_lock = threading.Lock()
        # Set by the watcher when it delivers an abort, so run_turn can recognize
        # a user stop even if pi's terminal event omits the stopReason.
        self.aborted_turn_id = None

    def set_turn_context(self, grant):
        self.current_grant = dict(grant or {})
        # Cleared per turn: a marker left from the turn the user just stopped must
        # never cancel the next one.
        self.aborted_turn_id = None

    def _start(self):
        pi_runtime_env = validate_pi_runtime_environment()
        validate_pi_config_materialization()
        if self.proc is not None and self.proc.poll() is None:
            return
        model = os.environ.get("PI_MODEL") or "sonnet"
        pi_command = [
            os.environ.get("PI_BIN", "/usr/local/bin/pi"),
            "--mode",
            "rpc",
            "--provider",
            PI_HARNESS_PROXY_PROVIDER,
            "--model",
            model,
            "--session-dir",
            pi_runtime_env["PI_CODING_AGENT_SESSION_DIR"],
        ]
        system_prompt = read_pi_system_prompt()
        if system_prompt:
            pi_command.extend(["--append-system-prompt", system_prompt])
        env = {
            "PATH": os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin"),
            "HOME": "/root" if os.environ.get("HARNESS_BACKEND") == "khora" else "/agent-home",
            "USER": "root" if os.environ.get("HARNESS_BACKEND") == "khora" else "harness",
            "LOGNAME": "root" if os.environ.get("HARNESS_BACKEND") == "khora" else "harness",
            "ANTHROPIC_BASE_URL": os.environ.get("ANTHROPIC_BASE_URL", ""),
        }
        env.update(pi_runtime_env)
        if os.environ.get("HARNESS_BACKEND") == "khora":
            env["HARNESS_BACKEND"] = "khora"
        for optional_name in ("LANG", "TMPDIR"):
            optional_value = os.environ.get(optional_name)
            if optional_value:
                env[optional_name] = optional_value
        target_uid = "0" if os.environ.get("HARNESS_BACKEND") == "khora" else os.environ.get("HARNESS_AGENT_UID", "65534")
        target_gid = "0" if os.environ.get("HARNESS_BACKEND") == "khora" else os.environ.get("HARNESS_AGENT_GID", "65534")
        if str(os.geteuid()) == target_uid and str(os.getegid()) == target_gid:
            command = pi_command
        else:
            command = [
                "setpriv",
                "--reuid",
                target_uid,
                "--regid",
                target_gid,
                "--clear-groups",
                "env",
                "HOME=/agent-home",
                "USER=harness",
                "LOGNAME=harness",
                *[f"{name}={value}" for name, value in env.items() if name.startswith("PI_")],
                *pi_command,
            ]
        self.proc = subprocess.Popen(
            command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
            env=env,
        )
        if self.proc.stderr is not None:
            threading.Thread(target=self._drain_stderr, args=(self.proc.stderr,), daemon=True).start()

    def _drain_stderr(self, stream):
        for line in stream:
            stripped = line.rstrip("\n")
            if stripped:
                with self.stderr_lock:
                    self.stderr_tail.append(stripped)
                print(f"[pi stderr] {stripped}", file=sys.stderr, flush=True)

    def _stderr_detail(self):
        with self.stderr_lock:
            lines = list(self.stderr_tail)
        if not lines:
            return ""
        detail = " | ".join(lines[-5:])
        if len(detail) > 1000:
            detail = detail[-1000:]
        return detail

    def _write_rpc(self, payload):
        # Serialized: the control watcher writes abort/steer on its own thread
        # while the turn thread is blocked reading pi's stdout.
        with self.stdin_lock:
            self.proc.stdin.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")
            self.proc.stdin.flush()

    def deliver_control(self, command, turn_id, message=""):
        """Apply a host control command to the turn currently executing.

        Called from the control-watcher thread, never from the turn thread. Both
        commands are pi RPC primitives that leave the pi process and its session
        intact, which is the whole point: stopping a turn must not cost the user
        their sandbox.

          abort — ends the turn with stopReason 'aborted'. Whatever already
                  streamed stays in pi's session history, and the host keeps it in
                  the transcript, so partial work survives being stopped.
          steer — injects the message into the turn that is still running, so the
                  agent picks up the new instruction without discarding the work
                  it has already done. It does NOT abort; that is the difference
                  from sending a new turn.

        Returns True when the command was written to pi.
        """
        if self.proc is None or self.proc.poll() is not None:
            return False
        if command == "abort":
            # Recorded before the write: the terminal event races back on the turn
            # thread, and it must be able to tell a user stop from a real failure.
            self.aborted_turn_id = turn_id
            self._write_rpc({"id": f"harness-abort-{turn_id}", "type": "abort"})
            return True
        if command == "steer":
            text = str(message or "")
            if not text:
                return False
            self._write_rpc({"id": f"harness-steer-{turn_id}", "type": "steer", "message": text})
            return True
        return False

    def _read_rpc(self):
        line = self.proc.stdout.readline()
        if line == "":
            rc = self.proc.poll()
            detail = "exited" if rc is None else f"exited with status {rc}"
            stderr_detail = self._stderr_detail()
            if stderr_detail:
                detail = f"{detail}: {stderr_detail}"
            raise RuntimeError(f"pi rpc process {detail}")
        stripped = line.rstrip("\n")
        try:
            payload = json.loads(stripped)
        except json.JSONDecodeError as err:
            raise RuntimeError(f"pi rpc emitted non-json output: {stripped}") from err
        return stripped, payload

    def _request_response(self, payload):
        self._write_rpc(payload)
        request_id = payload.get("id")
        command = payload.get("type")
        while True:
            _, event = self._read_rpc()
            if event.get("type") == "response" and event.get("id") == request_id:
                if not event.get("success", False):
                    detail = event.get("error") or event.get("message")
                    if detail:
                        raise RuntimeError(f"pi rpc command {command} failed: {detail}")
                    raise RuntimeError(f"pi rpc command {command} failed")
                return event
            if event.get("type") == "error":
                raise RuntimeError("pi rpc error during internal command")

    def _drain_to_barrier(self, barrier_id, label, timeout):
        """Read past prior-turn residue until our own barrier response arrives.

        THE INVARIANT this establishes: when run_turn returns, pi's stdout holds
        no events belonging to the turn just finished. The next turn's first read
        is therefore its own first event.

        Why a barrier and not read-until-quiet: pi's stream is nested,

            agent_start … [turn_start … turn_end]* … agent_end

        and run_turn stops on the first non-toolUse turn_end, which is an INNER
        boundary — so at minimum one agent_end is always still unread. Waiting for
        silence cannot distinguish "residue drained" from "model still thinking",
        and would cost the full timeout on every clean turn. A request/response
        barrier is self-clocking instead: everything read before our own response
        id is residue by definition, and the response itself proves pi has caught
        up with us.

        Bounded on purpose. The abort path returns the moment pi acknowledges the
        stop, so this must not be what makes a Stop hang; on timeout we log and
        carry on rather than fail the turn. A turn that could not be drained is
        reported honestly (see run_turn: a completed turn whose barrier never
        answered becomes a failure rather than a silent success), so the host
        retires the generation instead of running the next turn against a pipe
        nobody can vouch for.

        Returns the barrier response event, or None if it never arrived.
        """
        deadline = time.monotonic() + timeout
        discarded = []
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                print(f"[bridge] {label}: drain timed out with {len(discarded)} events read "
                      f"{sorted(set(discarded))}; pi may be wedged", file=sys.stderr, flush=True)
                return None
            try:
                _, event = self._read_rpc()
            except RuntimeError as err:
                # pi exited or emitted garbage. Nothing left to drain, and the
                # turn's own status has already been decided by the caller.
                print(f"[bridge] {label}: drain stopped: {err}", file=sys.stderr, flush=True)
                return None
            if event.get("type") == "response" and event.get("id") == barrier_id:
                if discarded:
                    print(f"[bridge] {label}: drained {len(discarded)} residue events "
                          f"{sorted(set(discarded))}", file=sys.stderr, flush=True)
                return event
            discarded.append(event.get("type"))

    def _barrier_request(self, barrier_id, label, timeout):
        """Write a cheap internal command and drain everything before its response."""
        try:
            self._write_rpc({"id": barrier_id, "type": "get_session_stats"})
        except (OSError, ValueError) as err:
            print(f"[bridge] {label}: barrier write failed: {err}", file=sys.stderr, flush=True)
            return None
        return self._drain_to_barrier(barrier_id, label, timeout)

    def run_turn(self, content, emit):
        validate_pi_config_materialization()
        self._start()
        turn_id = int(self.current_grant.get("turn_id") or 0)
        self._restore_session_if_needed(turn_id)
        prompt_id = f"harness-turn-{turn_id or int(time.time_ns())}"
        barrier_id = f"{prompt_id}-stats"
        status = "completed"
        error_class = ""
        error = ""
        stats_event = None
        try:
            self._write_rpc({"id": prompt_id, "type": "prompt", "message": content or ""})
            while True:
                stripped, event = self._read_rpc()
                event_type = event.get("type")
                if event_type in {"turn_end", "agent_end"} and pi_event_stop_reason(event) in {"toolUse", "tool_use"}:
                    continue
                emit("stdout", stripped)
                if event_type == "response" and event.get("id") == prompt_id and not event.get("success", False):
                    status = "failed"
                    error_class = "agent_prompt_rejected"
                    error = f"pi prompt rejected: {event.get('error') or event.get('message') or 'unknown error'}"
                    break
                if event_type == "error":
                    status = "failed"
                    error_class = "agent_execution_failed"
                    error = event.get("message") or event.get("error") or "pi rpc error"
                    break
                if event_type in {"turn_end", "agent_end"}:
                    if pi_event_stop_reason(event) == "aborted" or self.aborted_turn_id == turn_id:
                        status = "canceled"
                        error_class = "user_interrupted"
                        error = "interrupted by user"
                        break
                    terminal_status = str(event.get("status") or "completed")
                    if terminal_status not in {"completed", "success", "ok"}:
                        status = "failed"
                        error_class = "agent_execution_failed"
                        error = f"pi turn ended with status {terminal_status}"
                    break
        finally:
            # INVARIANT: every turn exit leaves pi's stdout at an agent boundary,
            # so the next turn's first read is its own first event. The stats call
            # is the boundary barrier for completed turns (reuses that response),
            # and for failed/abort turns (which need no stats) it drains residue.
            stats_event = self._barrier_request(barrier_id, f"turn {turn_id} boundary", timeout=12.0)
        if status != "completed":
            return status, error_class, error
        if not stats_event or not stats_event.get("success", False):
            return "failed", "agent_execution_failed", "pi stats barrier failed"
        driver_state_update = self._driver_state_update(stats_event.get("data") or {}, turn_id)
        return status, error_class, error, driver_state_update

    def _restore_session_if_needed(self, turn_id):
        token = self.current_grant.get("driver_state") or {}
        state_digest = str(token.get("state_digest") or "")
        if not state_digest or state_digest == self.restored_state_digest:
            return
        payload = token.get("state_payload")
        if payload is None:
            raise RuntimeError("pi restore state_payload is required")
        if not isinstance(payload, dict):
            raise RuntimeError("pi restore state_payload must be an object")
        state_kind = payload.get("state_kind")
        if state_kind == "pi_uninitialized":
            self.restored_state_digest = state_digest
            return
        if state_kind != "pi_session":
            raise RuntimeError(f"unsupported pi restore state_kind {state_kind}")
        expected_rel, expected_file = normalize_pi_session_file(payload.get("selected_session_file"))
        if expected_rel != payload.get("selected_session_relpath"):
            raise RuntimeError("pi restore session relpath mismatch")
        expected_session_id = str(payload.get("selected_session_id") or "").strip()
        if not expected_session_id:
            raise RuntimeError("pi restore selected_session_id is required")
        self._request_response(
            {
                "id": f"harness-restore-{turn_id or int(time.time_ns())}",
                "type": "switch_session",
                "sessionPath": expected_file,
            }
        )
        stats = self._request_response({"id": f"harness-restore-{turn_id or int(time.time_ns())}-stats", "type": "get_session_stats"})
        relpath, selected_file = normalize_pi_session_file((stats.get("data") or {}).get("sessionFile"))
        session_id = str((stats.get("data") or {}).get("sessionId") or "").strip()
        if relpath != expected_rel or selected_file != expected_file or session_id != expected_session_id:
            raise RuntimeError("pi restore selected session verification failed")
        self.restored_state_digest = state_digest

    def _driver_state_update(self, stats, turn_id):
        token = self.current_grant.get("driver_state") or {}
        previous_digest = str(token.get("state_digest") or "")
        previous_version = int(token.get("state_version") or 0)
        if token.get("driver_id") != "pi" or not previous_digest.startswith("sha256:") or previous_version <= 0:
            raise RuntimeError("pi turn grant missing current driver_state token")
        relpath, selected_file = normalize_pi_session_file(stats.get("sessionFile"))
        session_id = str(stats.get("sessionId") or "").strip()
        if not session_id:
            raise RuntimeError("pi sessionId is required")
        if os.environ.get("HARNESS_BACKEND") == "khora":
            sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
            from harness_files import native_state_barrier
            native_state_barrier(selected_file, PI_SESSION_DIR)
        state_payload = {
            "schema_version": 1,
            "driver_id": "pi",
            "state_kind": "pi_session",
            "session_dir": PI_SESSION_DIR,
            "selected_session_relpath": relpath,
            "selected_session_file": selected_file,
            "selected_session_id": session_id,
            "last_completed_turn_id": str(turn_id),
        }
        return {
            "driver_id": "pi",
            "previous_state_digest": previous_digest,
            "state_payload": state_payload,
            "state_digest": driver_state_digest(state_payload),
            "state_version": previous_version + 1,
        }

    def close(self):
        if self.proc is None:
            return
        try:
            self.proc.terminate()
        except OSError:
            pass


class NativeEventsProbeRunner:
    def run_turn(self, content, emit):
        emit(
            "stdout",
            {
                "schema": "harness_native_events_v1",
                "event": {
                    "type": "agent.message",
                    "payload": {"content": content},
                },
            },
        )
        return "completed", "", ""

    def close(self):
        pass


RUNNER_FACTORIES = {
    "pi": PiRPCTurnRunner,
    "sh": ShellTurnRunner,
    "native_events_probe": NativeEventsProbeRunner,
}


def make_turn_runner(driver_id):
    driver_id = (driver_id or "").strip()
    factory = RUNNER_FACTORIES.get(driver_id)
    if factory is not None:
        return factory()
    raise RuntimeError(f"unsupported driver {driver_id}")


def sandbox_source_ip():
    try:
        output = subprocess.check_output(["ip", "-j", "addr", "show"], text=True)
        for link in json.loads(output):
            if link.get("ifname") == "lo":
                continue
            for addr in link.get("addr_info", []):
                if addr.get("family") == "inet" and addr.get("local"):
                    return addr["local"]
    except Exception:
        pass
    return "127.0.0.1"


def parse_statuses(value, default):
    if value is None or str(value).strip() == "":
        return set(default)
    statuses = set()
    for raw in str(value).split(","):
        raw = raw.strip()
        if raw:
            statuses.add(int(raw))
    return statuses


def http_status(url, method="GET", headers=None, body=None, timeout=3.0):
    request = urllib.request.Request(url, data=body, method=method, headers=headers or {})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status
    except urllib.error.HTTPError as err:
        return err.code


def run_network_probe(base_url, healthz_statuses, timeout):
    if not base_url:
        raise RuntimeError("ANTHROPIC_BASE_URL is required for probe")
    base_url = base_url.rstrip("/")
    healthz_status = http_status(f"{base_url}/healthz", timeout=timeout)
    if healthz_status not in healthz_statuses:
        raise RuntimeError(f"probe GET /healthz returned {healthz_status}, want one of {sorted(healthz_statuses)}")


def run_probe(args):
    driver_id = args_driver_id(args)
    client = BridgeClient(args.bridge_dir, args.session_id, args.generation_id, driver_id, args.poll_interval)
    client.heartbeat()
    client.hello(timeout=args.timeout)
    if driver_id == "pi":
        run_network_probe(
            args.base_url,
            parse_statuses(args.healthz_statuses, {200}),
            args.http_timeout,
        )
    client.probe_network(timeout=args.timeout)
    client.touch_bridge_heartbeat()
    client.mark_checkpoint_ready()


def run_heartbeat_loop(args):
    client = BridgeClient(args.bridge_dir, args.session_id, args.generation_id, args_driver_id(args), args.poll_interval)
    interval = max(args.interval, 0.001)
    while True:
        client.heartbeat()
        time.sleep(interval)


def start_background_heartbeat(client, interval):
    stop = threading.Event()

    def loop():
        while not stop.wait(max(interval, 0.001)):
            try:
                client.heartbeat()
            except Exception as err:
                print(f"[bridge] heartbeat failed: {err}", file=sys.stderr, flush=True)

    thread = threading.Thread(target=loop, daemon=True)
    thread.start()
    return stop


def start_turn_control_watcher(root, runner, turn_id, interval=0.2):
    """Watch for host abort/steer while a turn executes, and apply it to pi.

    Exists because the turn thread is blocked in _read_rpc for the whole turn: no
    amount of inbox polling elsewhere can reach it, so the delivery has to happen
    on a second thread. Modeled on start_background_heartbeat above — daemon
    thread, stop via Event, every exception contained.

    Containment matters more than usual here: this process is the sandbox's init,
    so an exception escaping this thread would take the sandbox down, which is the
    exact cost this whole change exists to avoid.

    Each token is applied at most once. Abort ends the watch (the turn is over);
    steer does not, because the turn keeps running and the user may steer again.
    """
    stop = threading.Event()
    if not hasattr(runner, "deliver_control"):
        return stop
    applied = set()

    def loop():
        while not stop.wait(max(interval, 0.01)):
            try:
                for control in read_turn_control(root):
                    if control["token"] in applied:
                        continue
                    # An entry naming a different turn is stale: the host wrote it
                    # for a turn that has since ended. Ignoring it is what keeps a
                    # late abort from killing the turn that came after it.
                    if control["turn_id"] != turn_id:
                        continue
                    applied.add(control["token"])
                    delivered = runner.deliver_control(control["command"], turn_id, control.get("message", ""))
                    if delivered:
                        print(f"[bridge] applied {control['command']} to turn {turn_id}", file=sys.stderr, flush=True)
                    # Abort ends the watch: the turn is over, so anything after it
                    # in the log belongs to a turn this watcher will never see.
                    if delivered and control["command"] == "abort":
                        return
            except Exception as err:
                print(f"[bridge] turn control watch failed: {err}", file=sys.stderr, flush=True)

    thread = threading.Thread(target=loop, daemon=True)
    thread.start()
    return stop


def execute_grant(client, runner, grant):
    turn_id = int(grant["turn_id"])
    run_turn = grant.get("input") or {}
    if grant.get("turn_input_schema") != "RunTurn":
        raise RuntimeError(f"unsupported turn_input_schema {grant.get('turn_input_schema')}")
    content = str(run_turn.get("content") or "")
    output_sequence = int(client.last_output_sequence_by_turn.get(turn_id, 0)) + 1
    client.clear_checkpoint_ready()
    client.ack_turn_started(turn_id, "" if isinstance(client, StdioBridgeClient) else sandbox_source_ip())

    def emit(stream, line):
        nonlocal output_sequence
        payload = line if isinstance(line, dict) else {"line": line}
        client.emit_output(turn_id, output_sequence, payload, stream=stream or "stdout")
        output_sequence += 1

    # Started before the turn and stopped in the finally below, so the window in
    # which a Stop can land is exactly the window in which the turn is running.
    stop_control_watch = client.start_control_watcher(runner, turn_id) if hasattr(client, "start_control_watcher") else start_turn_control_watcher(client.root, runner, turn_id)
    try:
        if hasattr(runner, "set_turn_context"):
            runner.set_turn_context(grant)
        result = runner.run_turn(content, emit)
        driver_state_update = None
        if isinstance(result, dict):
            status = result.get("status") or "completed"
            error_class = result.get("error_class") or ""
            error = result.get("error") or ""
            driver_state_update = result.get("driver_state_update")
        else:
            status, error_class, error = result[:3]
            if len(result) > 3:
                driver_state_update = result[3]
    except Exception as err:
        status, error_class, error = "failed", "agent_execution_failed", str(err)
        driver_state_update = None
        emit("stderr", str(err))
    finally:
        stop_control_watch.set()
    if status != "completed":
        driver_state_update = None
    client.last_output_sequence_by_turn[turn_id] = output_sequence - 1
    client.ack_turn_completed(
        turn_id,
        status=status or "completed",
        error_class=error_class,
        error=error,
        driver_state_update=driver_state_update,
    )
    client.mark_checkpoint_ready()


def run_claim_loop(args, runner=None):
    driver_id = args_driver_id(args)
    client_type = StdioBridgeClient if getattr(args, "transport", "files") == "stdio" else BridgeClient
    client = client_type(args.bridge_dir, args.session_id, args.generation_id, driver_id, args.poll_interval)
    client.acquire_producer_lock()
    try:
        client.heartbeat()
        client.hello(timeout=args.timeout)
        if driver_id == "pi":
            run_network_probe(
                args.base_url,
                parse_statuses(args.healthz_statuses, {200}),
                args.http_timeout,
            )
        client.probe_network(timeout=args.timeout)
        client.mark_checkpoint_ready()
        runner = runner or make_turn_runner(driver_id)
        stop_heartbeat = start_background_heartbeat(client, args.heartbeat_interval)
        completed = 0
        empty_polls = 0
        claim_failures = 0
        max_claim_failures = int(getattr(args, "max_claim_failures", DEFAULT_MAX_CLAIM_FAILURES) or 0)
        resume_turn_id = client.leased_turn_id
        try:
            while args.max_turns <= 0 or completed < args.max_turns:
                # A claim that fails is a bridge hiccup, not a reason to exit.
                # Exiting here is what tore the sandbox down: this process is
                # the container's init, so any exception escaping the loop ended
                # the sandbox and the host then had to cold-start a new one. A
                # slow host (the orchestrator's poll worker busy on the single
                # writer) or a response file pruned mid-read is retried with a
                # short backoff; only a sustained run of failures gives up, and
                # that exit is logged with its reason.
                try:
                    if resume_turn_id is not None:
                        grant = client.resume_turn(int(resume_turn_id), timeout=args.timeout)
                        resume_turn_id = None
                    else:
                        grant = client.claim_next_turn(timeout=args.timeout)
                except (TimeoutError, RuntimeError, OSError) as err:
                    claim_failures += 1
                    print(f"[bridge] claim failed ({claim_failures}/{max_claim_failures}): {err}", file=sys.stderr, flush=True)
                    if max_claim_failures > 0 and claim_failures >= max_claim_failures:
                        print("[bridge] giving up after sustained claim failures", file=sys.stderr, flush=True)
                        raise
                    time.sleep(min(1.0 * claim_failures, 10.0))
                    continue
                claim_failures = 0
                if grant is None:
                    empty_polls += 1
                    if args.max_empty_polls > 0 and empty_polls >= args.max_empty_polls:
                        return
                    time.sleep(max(args.idle_interval, 0.001))
                    continue
                empty_polls = 0
                execute_grant(client, runner, grant)
                completed += 1
        finally:
            stop_heartbeat.set()
            if hasattr(runner, "close"):
                runner.close()
    finally:
        client.release_producer_lock()


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("--transport", choices=("files", "stdio"), default="files")
    parser.add_argument("--bridge-dir", default=os.environ.get("HARNESS_BRIDGE_DIR", "/harness-control/bridge"))
    parser.add_argument("--session-id", default=os.environ.get("SESSION_ID"))
    parser.add_argument("--generation-id", default=os.environ.get("GENERATION_ID"))
    parser.add_argument("--driver-id", default=os.environ.get("HARNESS_DRIVER_ID", ""))
    parser.add_argument("--poll-interval", type=float, default=float(os.environ.get("HARNESS_BRIDGE_POLL_INTERVAL", "0.05")))
    # Response wait for hello/probe/claim. Generous on purpose: the host answers
    # a claim from its bridge-poll worker, which shares the orchestrator's single
    # SQLite writer and is routinely delayed by seconds under output load. A
    # timeout here is retried by the claim loop, so this bounds latency of one
    # attempt rather than deciding whether the sandbox lives.
    parser.add_argument("--timeout", type=float, default=float(os.environ.get("HARNESS_BRIDGE_TIMEOUT", "30")))
    parser.add_argument("--base-url", default=os.environ.get("ANTHROPIC_BASE_URL", ""))
    parser.add_argument("--healthz-statuses", default=os.environ.get("HARNESS_PROBE_HEALTHZ_STATUSES", "200"))
    parser.add_argument("--http-timeout", type=float, default=float(os.environ.get("HARNESS_PROBE_HTTP_TIMEOUT", "3")))
    subcommands = parser.add_subparsers(dest="command", required=True)
    subcommands.add_parser("probe")
    heartbeat_loop = subcommands.add_parser("heartbeat-loop")
    heartbeat_loop.add_argument("--interval", type=float, default=float(os.environ.get("HARNESS_BRIDGE_HEARTBEAT_INTERVAL", "30")))
    claim_loop = subcommands.add_parser("claim-loop")
    claim_loop.add_argument("--idle-interval", type=float, default=float(os.environ.get("HARNESS_BRIDGE_IDLE_INTERVAL", "0.05")))
    claim_loop.add_argument("--heartbeat-interval", type=float, default=float(os.environ.get("HARNESS_BRIDGE_HEARTBEAT_INTERVAL", "30")))
    claim_loop.add_argument("--max-turns", type=int, default=0)
    claim_loop.add_argument("--max-empty-polls", type=int, default=0)
    claim_loop.add_argument("--max-claim-failures", type=int, default=int(os.environ.get("HARNESS_BRIDGE_MAX_CLAIM_FAILURES", str(DEFAULT_MAX_CLAIM_FAILURES))))
    args = parser.parse_args(argv)
    if not args.session_id or not args.generation_id:
        parser.error("--session-id and --generation-id are required")
    if not args.driver_id:
        parser.error("--driver-id is required")
    if args.command == "probe":
        run_probe(args)
    elif args.command == "heartbeat-loop":
        run_heartbeat_loop(args)
    elif args.command == "claim-loop":
        run_claim_loop(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
