{
  "name": "agent-runtime-admin-frontend",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint . --max-warnings=0 --cache --cache-strategy content --cache-location .next/cache/eslint/",
    "typecheck": "tsc --noEmit",
    "typecheck:built": "tsc --noEmit --tsBuildInfoFile .next/cache/.tsbuildinfo",
    "test": "vitest run",
    "test:ui:built": "playwright test"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "typescript": "5.9.3",
    "@playwright/test": "1.63.0",
    "vitest": "4.1.11"
  }
}
